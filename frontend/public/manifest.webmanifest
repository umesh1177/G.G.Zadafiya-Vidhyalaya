      "url": "/principal",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Faculty Dashboard",
      "short_name": "Faculty",
      "description": "Open Subject Faculty LT, Exam Unit, and Syllabus",
      "url": "/faculty",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
