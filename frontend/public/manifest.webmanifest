{
  "id": "/",
  "name": "G.G. Zadafiya Vidhyalaya — Academic Portal",
  "short_name": "GGZV Portal",
  "description": "G.G. Zadafiya Vidhyalaya Science Stream Combined Academic, Syllabus, Exam & Lecture Test Dashboard",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#F6F7FB",
  "theme_color": "#123B5D",
