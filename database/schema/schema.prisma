// =========================================================================
// PRISMA SCHEMA FOR 11-12TH SCIENCE STREAM SCHOOL MANAGEMENT SYSTEM (SMS)
// Database: PostgreSQL
// Roles: Student, Assistant Faculty, Subject Faculty, Principal
// Streams: Group A (PCM - Physics, Chemistry, Maths), Group B (PCB - Physics, Chemistry, Biology)
// Exams: Board, JEE, NEET, GUJCET, Weekly, Monthly, Annual
// =========================================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// =========================================================================
// ENUMS
// =========================================================================

enum Role {
  STUDENT
  ASSISTANT_FACULTY
  SUBJECT_FACULTY
  PRINCIPAL
}

enum Standard {
  STD_11
  STD_12
}

enum Division {
  A
  B
}

enum StreamGroup {
  GROUP_A   // PCM: Physics, Chemistry, Maths
  GROUP_B   // PCB: Physics, Chemistry, Biology
  GROUP_AB  // PCMB: Physics, Chemistry, Maths, Biology
}

enum SubjectCode {
  PHYSICS
  CHEMISTRY
  MATHEMATICS
  BIOLOGY
  ENGLISH
  COMPUTER
}

enum ExamType {
  BOARD
  JEE
  NEET
  GUJCET
  WEEKLY
  MONTHLY
  ANNUAL
  UNIT
}

enum ExamStatus {
  UPCOMING
  AWAITING_MARKS
  EVALUATED
  PUBLISHED
  CANCELLED
}

enum LtGrade {
  EXCELLENT
  BETTER
  GOOD
  AB
}

enum LtStatus {
  PENDING_EVALUATION
  EVALUATED
  CANCELLED
}

enum StudentStatus {
  ACTIVE
  ALUMNI
  INACTIVE
}

enum DisciplineType {
  COME_LATE
  LONG_HAIR
  LONG_NAIL
  UNIFORM_ISSUE
  OTHER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum AttendanceSession {
  MORNING
  AFTERNOON
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ReportPeriodType {
  WEEKLY
  MONTHLY
  ANNUAL
}

// =========================================================================
// 1. AUTHENTICATION & CORE USERS
// =========================================================================

model User {
  id            String    @id @default(cuid())
  username      String    @unique
  passwordHash  String
  email         String    @unique
  contactNo     String?
  role          Role
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // 1-to-1 profile relationships based on Role
  studentProfile   Student?
  facultyProfile   Faculty?
  principalProfile Principal?

  @@index([role, isActive])
  @@map("users")
}

// =========================================================================
// 2. PRINCIPAL PROFILE
// =========================================================================

model Principal {
  id             String    @id @default(cuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  email          String    @unique
  contactNo      String?
  schoolName     String    @default("Shree Vidya Vihar Science School")
  qualification  String?
  joiningDate    DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  createdNotices Notice[]

  @@map("principals")
}

// =========================================================================
// 3. FACULTY PROFILE (Subject Faculty & Assistant Faculty)
// =========================================================================

model Faculty {
  id               String       @id @default(cuid())
  userId           String       @unique
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  email            String       @unique
  contactNo        String
  role             Role         // SUBJECT_FACULTY or ASSISTANT_FACULTY
  primarySubject   SubjectCode? // e.g. PHYSICS, CHEMISTRY, MATHEMATICS, BIOLOGY
  joiningDate      DateTime     @default(now())
  resignationDate  DateTime?
  isActive         Boolean      @default(true)
  photoUrl         String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  // Subject Faculty Allocations
  allocations             FacultySubjectAllocation[]

  // Syllabus Completion: Topics marked 'Finished' today by this Subject Faculty
  syllabusCompletions     SyllabusCompletion[]

  // LT Module Relationships:
  // - Subject Faculty creates LT
  createdLTs              LectureTest[]        @relation("LtCreator")
  // - Assistant Faculty assigned to monitor or record marks
  assignedAssistantLTs    LectureTest[]        @relation("LtAssistant")
  // - Assistant Faculty who evaluated & recorded marks for students
  evaluatedLtMarks        LtMarkEntry[]        @relation("LtEvaluator")

  // Exam Module Relationships:
  // - Subject Faculty creates/sets unit coverage & question paper for Exam
  createdExams            Exam[]               @relation("ExamCreator")
  // - Assistant Faculty assigned to conduct the Exam
  conductedExams          Exam[]               @relation("ExamConductor")
  // - Assistant Faculty who entered the student marks
  enteredExamMarks        ExamMarkEntry[]      @relation("ExamMarkRecorder")

  // Operations performed by Assistant Faculty
  generatedResultBatches  ResultBatch[]        @relation("ResultGenerator")
  generatedHallTicketBatches HallTicketBatch[] @relation("HallTicketGenerator")

  // Discipline Remarks logged by Faculty/Assistant
  notedDisciplineRemarks  DisciplineRemark[]   @relation("DisciplineNoter")

  @@index([role, isActive])
  @@map("faculties")
}

// =========================================================================
// 4. STUDENT PROFILE (Active Students & Alumni)
// =========================================================================

model Student {
  id              String         @id @default(cuid())
  userId          String         @unique
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  rollNo          Int
  firstName       String
  middleName      String?
  lastName        String
  fullName        String
  standard        Standard       // STD_11 or STD_12
  division        Division       // A or B
  streamGroup     StreamGroup    // GROUP_A (PCM), GROUP_B (PCB), GROUP_AB (PCMB)
  admissionDate   DateTime       @default(now())
  contactNo       String
  email           String?
  avatarUrl       String?
  schoolName      String         @default("Shree Vidya Vihar Science School")
  status          StudentStatus  @default(ACTIVE)

  // Alumni Specific Fields (from EJS Alumni form)
  graduationYear  Int?
  currentPursuit  String?        // e.g. "B.Tech Engineering", "MBBS", "Pharmacy"
  endingDate      DateTime?

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Academic Records
  ltMarks         LtMarkEntry[]
  examMarks       ExamMarkEntry[]
  attendances     StudentAttendance[]
  disciplineNotes DisciplineRemark[]
  resultItems     ResultItem[]
  hallTickets     HallTicket[]
  progressReports ProgressReport[]

  @@unique([standard, division, rollNo])
  @@index([standard, division, streamGroup, status])
  @@map("students")
}

// =========================================================================
// 5. SUBJECTS, CHAPTERS, TOPICS & SYLLABUS
// =========================================================================

model Subject {
  id              String                     @id @default(cuid())
  code            SubjectCode                @unique
  name            String                     // Physics, Chemistry, Mathematics, Biology
  isCoreScience   Boolean                    @default(true)
  applicableGroup StreamGroup?               // null = both, GROUP_A = Maths, GROUP_B = Biology

  chapters        Chapter[]
  allocations     FacultySubjectAllocation[]
  lectureTests    LectureTest[]

  @@map("subjects")
}

model Chapter {
  id          String              @id @default(cuid())
  subjectId   String
  subject     Subject             @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  standard    Standard
  chapterNo   Int
  chapterName String
  description String?

  topics      Topic[]
  examUnits   ExamUnitCoverage[]

  @@unique([subjectId, standard, chapterNo])
  @@index([standard, subjectId])
  @@map("chapters")
}

model Topic {
  id             String               @id @default(cuid())
  chapterId      String
  chapter        Chapter              @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  topicNo        String               // e.g. "1.1", "1.2", "8.4"
  name           String
  estimatedHours Float?

  subtopics      Subtopic[]
  completions    SyllabusCompletion[]
  ltCoverages    LtTopicCoverage[]

  @@unique([chapterId, topicNo])
  @@map("topics")
}

model Subtopic {
  id             String    @id @default(cuid())
  topicId        String
  topic          Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)
  name           String
  sampleQuestion String?
  marks          Float?

  @@map("subtopics")
}

// Tracks when Subject Faculty marks a topic as "Finished" in the Syllabus tab
model SyllabusCompletion {
  id            String    @id @default(cuid())
  topicId       String
  topic         Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)
  facultyId     String    // Subject Faculty who taught it
  faculty       Faculty   @relation(fields: [facultyId], references: [id])
  standard      Standard
  division      Division
  completedDate DateTime  @default(now())
  isFinished    Boolean   @default(true)
  notes         String?
  createdAt     DateTime  @default(now())

  @@unique([topicId, standard, division])
  @@index([standard, division, completedDate])
  @@map("syllabus_completions")
}

// Maps Faculty to Subject + Standard + Division
model FacultySubjectAllocation {
  id           String      @id @default(cuid())
  facultyId    String
  faculty      Faculty     @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  subjectId    String
  subject      Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  standard     Standard
  division     Division
  academicYear String      // e.g. "2026-2027"

  @@unique([facultyId, subjectId, standard, division, academicYear])
  @@map("faculty_subject_allocations")
}

// =========================================================================
// 6. LT (LECTURE TEST) MODULE
// Flow: Subject faculty picks today's finished topics -> sets LT ->
//       Assistant faculty monitors -> Assistant faculty evaluates Excellent/Better/Good/AB
// =========================================================================

model LectureTest {
  id                  String             @id @default(cuid())
  ltNo                Int
  date                DateTime
  standard            Standard
  division            Division?          // null = all divisions of that standard
  streamGroup         StreamGroup?       // null = common (Physics/Chemistry), GROUP_A = Maths, GROUP_B = Biology
  subjectId           String
  subject             Subject            @relation(fields: [subjectId], references: [id])
  timeMinutes         Int                @default(15) // e.g. 15 or 20 minutes
  totalMarks          Float              @default(20)
  status              LtStatus           @default(PENDING_EVALUATION)
  
  // Faculty mapping:
  createdById         String             // Subject Faculty who created the LT
  createdBy           Faculty            @relation("LtCreator", fields: [createdById], references: [id])
  assignedAssistantId String?            // Assistant Faculty assigned
  assignedAssistant   Faculty?           @relation("LtAssistant", fields: [assignedAssistantId], references: [id])
  
  questionDetails     String?            // Written questions or selected topics prompt
  solutionFileUrl     String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  topicsCovered       LtTopicCoverage[]
  studentMarks        LtMarkEntry[]

  @@index([standard, date, subjectId, status])
  @@map("lecture_tests")
}

// Junction table for topics tested in an LT
model LtTopicCoverage {
  id      String      @id @default(cuid())
  ltId    String
  lt      LectureTest @relation(fields: [ltId], references: [id], onDelete: Cascade)
  topicId String
  topic   Topic       @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([ltId, topicId])
  @@map("lt_topic_coverages")
}

// Marks recorded for each student in an LT
model LtMarkEntry {
  id             String       @id @default(cuid())
  ltId           String
  lt             LectureTest  @relation(fields: [ltId], references: [id], onDelete: Cascade)
  studentId      String
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  // Grade matching the EJS prototype buttons: Excellent, Better, Good, AB
  scoreGrade     LtGrade      @default(GOOD)
  numericScore   Float?
  isAbsent       Boolean      @default(false)
  
  // Evaluated by Assistant Faculty
  evaluatedById  String
  evaluatedBy    Faculty      @relation("LtEvaluator", fields: [evaluatedById], references: [id])
  evaluatedAt    DateTime     @default(now())
  remarks        String?
  
  // Flagged for student's "Weak Topic List" if score is Good or AB
  isWeakTopic    Boolean      @default(false)

  @@unique([ltId, studentId])
  @@index([studentId, isWeakTopic])
  @@index([evaluatedById, evaluatedAt])
  @@map("lt_mark_entries")
}

// =========================================================================
// 7. EXAM MODULE
// Flow: Subject faculty selects unit ("Till Topic X" or "All Topics") ->
//       Sets Board / JEE / NEET / GUJCET ->
//       Assistant faculty enters single or 3-subject marks (PCM / PCB)
// =========================================================================

model Exam {
  id                  String             @id @default(cuid())
  examNo              Int                @unique
  title               String
  examType            ExamType           // BOARD, JEE, NEET, GUJCET, WEEKLY, MONTHLY, ANNUAL
  standard            Standard
  division            Division?          // null = all divisions of standard
  applicableGroup     StreamGroup?       // null = all, GROUP_A = JEE (PCM), GROUP_B = NEET (PCB)
  subject             String             // e.g. "Physics", "Chemistry", "PCM", "PCB", "PCMB"
  date                DateTime
  startTime           DateTime?
  endTime             DateTime?
  totalMarks          Float              // e.g. 100 for Board, 300 for JEE, 720 for NEET, 120 for GUJCET
  passingMarks        Float?
  unitCoverageSummary String             // e.g. "Ch 8 (Gravitation) — Till 8.4" or "Ch 1, 2 All Topics"
  questionPaperUrl    String?
  status              ExamStatus         @default(UPCOMING)

  // Faculty mapping:
  createdById         String             // Subject Faculty who created the exam syllabus unit
  createdBy           Faculty            @relation("ExamCreator", fields: [createdById], references: [id])
  conductedById       String?            // Assistant Faculty who conducted/supervised
  conductedBy         Faculty?           @relation("ExamConductor", fields: [conductedById], references: [id])

  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  coveredUnits        ExamUnitCoverage[]
  studentMarks        ExamMarkEntry[]

  @@index([standard, date, examType, status])
  @@map("exams")
}

// Details which chapters & topics an exam covers
model ExamUnitCoverage {
  id             String    @id @default(cuid())
  examId         String
  exam           Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  chapterId      String
  chapter        Chapter   @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  tillTopicId    String?   // null if all topics in chapter are included
  isFullChapter  Boolean   @default(false)
  unitLabel      String    // e.g. "Ch 8 (Gravitation) — Till 8.4"

  @@map("exam_unit_coverages")
}

// Student Exam Marks: Handles both Single-Subject (Board) and Multi-Subject (JEE/NEET/GUJCET)
model ExamMarkEntry {
  id                 String       @id @default(cuid())
  examId             String
  exam               Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId          String
  student            Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  // 1) For Single Subject Exams (Board, Weekly Single Unit):
  singleSubjectScore Float?

  // 2) For Multi-Subject Exams (JEE, NEET, GUJCET):
  physicsScore       Float?       // Common to Group A & Group B
  chemistryScore     Float?       // Common to Group A & Group B
  mathsScore         Float?       // For Group A (PCM)
  biologyScore       Float?       // For Group B (PCB)

  // Total auto-calculated sum
  totalScore         Float        @default(0)
  percentage         Float?
  rank               Int?         // Standard rank in this exam
  percentile         Float?
  isAbsent           Boolean      @default(false)

  // Assistant faculty audit trail:
  enteredById        String       // Assistant faculty who recorded or edited the marks
  enteredBy          Faculty      @relation("ExamMarkRecorder", fields: [enteredById], references: [id])
  enteredAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@unique([examId, studentId])
  @@index([examId, totalScore])
  @@index([studentId, examId])
  @@map("exam_mark_entries")
}

// =========================================================================
// 8. RESULT GENERATION MODULE
// Flow: Assistant faculty selects standard + exam date + subjects ->
//       Auto-fetches exam marks -> generates student result sheets
// =========================================================================

model ResultBatch {
  id               String           @id @default(cuid())
  batchNo          Int              @default(autoincrement())
  standard         Standard
  division         Division?
  streamGroup      StreamGroup?     // null = both groups
  resultType       ReportPeriodType // WEEKLY, MONTHLY, ANNUAL
  date             DateTime
  academicPeriod   String           // e.g. "19 May - 25 May 2026", "May 2026"
  status           PublishStatus    @default(DRAFT)
  publishedAt      DateTime?
  
  // Generated by Assistant Faculty
  generatedById    String
  generatedBy      Faculty          @relation("ResultGenerator", fields: [generatedById], references: [id])
  
  // JSON array of subject breakdown included, e.g. ["Physics", "Chemistry", "Maths"]
  includedSubjects Json
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  studentResults   ResultItem[]

  @@index([standard, resultType, date])
  @@map("result_batches")
}

model ResultItem {
  id                 String        @id @default(cuid())
  resultBatchId      String
  resultBatch        ResultBatch   @relation(fields: [resultBatchId], references: [id], onDelete: Cascade)
  studentId          String
  student            Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  totalMarksObtained Float
  maxMarks           Float
  percentage         Float
  classRank          Int
  overallPercentile  Float
  
  // Structured subject marks breakdown, e.g.:
  // [{ subject: "Physics", marks: 82, max: 100, grade: "A" }, ...]
  subjectBreakdown   Json
  status             PublishStatus @default(DRAFT)
  createdAt          DateTime      @default(now())

  @@unique([resultBatchId, studentId])
  @@index([studentId, resultBatchId])
  @@map("result_items")
}

// =========================================================================
// 9. HALL TICKET GENERATION MODULE
// Flow: Assistant faculty sets standard + exam type + subject schedule ->
//       Generates printable hall tickets with seat numbers
// =========================================================================

model HallTicketBatch {
  id             String        @id @default(cuid())
  batchNo        Int           @default(autoincrement())
  standard       Standard
  examType       ExamType
  examDate       DateTime
  status         PublishStatus @default(DRAFT)
  
  // Generated by Assistant Faculty
  generatedById  String
  generatedBy    Faculty       @relation("HallTicketGenerator", fields: [generatedById], references: [id])
  
  // Schedule array: [{ subject: "Physics", date: "2026-05-19", time: "10:00 AM - 01:00 PM" }, ...]
  scheduleDetails Json
  formatTemplate String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tickets        HallTicket[]

  @@index([standard, examType, examDate])
  @@map("hall_ticket_batches")
}

model HallTicket {
  id           String          @id @default(cuid())
  batchId      String
  batch        HallTicketBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)

  seatNumber   String          // e.g. "SVV-11A-001"
  centerName   String          @default("Shree Vidya Vihar Science School Campus")
  issuedDate   DateTime        @default(now())
  status       PublishStatus   @default(DRAFT)

  @@unique([batchId, studentId])
  @@index([studentId, batchId])
  @@map("hall_tickets")
}

// =========================================================================
// 10. STUDENT PROGRESS REPORTS & ANALYTICS
// Flow: Aggregates Weekly/Monthly progress metrics for Student/Parent View & Principal View
// =========================================================================

model ProgressReport {
  id                 String           @id @default(cuid())
  studentId          String
  student            Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  reportType         ReportPeriodType // WEEKLY, MONTHLY
  academicPeriod     String           // e.g. "Week 4, May 2026", "May 2026"
  
  averageScore       Float
  classAverage       Float?
  examAverage        Float?
  ltAverage          Float?
  growthVsLastPeriod Float            @default(0) // Month-over-month or week-over-week %
  rank               Int
  rankChange         String?          // e.g. "+2", "-1"
  percentile         Float
  peerBenchmark      String?          // e.g. "Top 5% of class"
  consistencyScore   Float?           // e.g. 9.4 / 10
  
  // Arrays and objects stored for fast dashboard rendering:
  topInSubjects      Json?            // e.g. ["Physics", "Mathematics"]
  weakAreas          Json?            // e.g. [{ subject: "Chemistry", topic: "Mole Concept", tag: "Revision" }]
  subjectAverages    Json?            // e.g. [{ subject: "Physics", avg: 96 }, ...]
  trendData          Json?            // 4-week trend: [{ week: "Week 1", avg: 82 }, ...]
  summaryMessage     String
  
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([studentId, reportType, academicPeriod])
  @@index([studentId, reportType])
  @@map("progress_reports")
}

// =========================================================================
// 11. ATTENDANCE, DISCIPLINE REMARKS & NOTICES
// =========================================================================

model StudentAttendance {
  id         String            @id @default(cuid())
  studentId  String
  student    Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date       DateTime
  session    AttendanceSession @default(MORNING)
  status     AttendanceStatus  @default(PRESENT)
  markedById String?
  createdAt  DateTime          @default(now())

  @@unique([studentId, date, session])
  @@index([date, status])
  @@map("student_attendances")
}

model DisciplineRemark {
  id           String         @id @default(cuid())
  studentId    String
  student      Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  incidentType DisciplineType
  date         DateTime       @default(now())
  message      String
  
  // Noted by Staff (Assistant Faculty, Subject Faculty, or Principal)
  notedById    String
  notedBy      Faculty        @relation("DisciplineNoter", fields: [notedById], references: [id])
  notedByName  String
  standard     Standard
  division     Division
  createdAt    DateTime       @default(now())

  @@index([studentId, date])
  @@map("discipline_remarks")
}

model Notice {
  id             String    @id @default(cuid())
  srNo           Int       @default(autoincrement())
  title          String
  message        String
  targetRole     Role?     // null = broadcast to all
  targetStandard Standard? // null = all standards
  date           DateTime  @default(now())
  
  // Created by Principal
  createdById    String?
  createdBy      Principal? @relation(fields: [createdById], references: [id])
  createdAt      DateTime  @default(now())

  @@index([date, targetRole])
  @@map("notices")
}

