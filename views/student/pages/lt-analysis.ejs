<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head', { title: 'LT Analysis' }) %>
</head>
<body>
  <div class="app">
    <%- include('../partials/sidebar', { active: 'ltAnalysis', data: data }) %>

    <div class="main">
      <%- include('../partials/topbar', { title: 'LT Analysis', subtitle: 'Daily Lecture Test performance, subject by subject', data: data }) %>

      <div class="content">

        <div class="grid-2">
          <div class="card chart-card">
            <div class="card__title" style="margin-bottom:14px;">This Week</div>
            <canvas id="thisWeekChart" height="190"></canvas>
          </div>
          <div class="card chart-card">
            <div class="card__title" style="margin-bottom:14px;">Growth Rate (Weekly Average)</div>
            <canvas id="growthRateChart" height="190"></canvas>
          </div>
        </div>

        <div class="card">
          <div class="card__head">
            <div>
              <div class="card__title">Weak Topic List</div>
              <div class="card__desc">Topics scored "Good" — worth a quick revision</div>
            </div>
          </div>
          <div class="table-wrap">
            <table>
              <thead><tr><th>LT No</th><th>Subject</th><th>Date</th><th>Score</th><th>Action</th></tr></thead>
              <tbody>
                <% data.lt.weakTopics.forEach(function(w){ %>
                  <tr>
                    <td class="num"><%= w.ltNo %></td><td><%= w.subject %></td><td class="num"><%= w.date %></td>
                    <td><span class="chip chip-warning"><%= w.score %></span></td>
                    <td><button class="btn btn-ghost btn-sm" data-modal-open="topicModal<%= w.ltNo %>">View Topic</button></td>
                  </tr>
                <% }) %>
                <% if (data.lt.weakTopics.length === 0) { %>
                  <tr><td colspan="5" style="text-align:center; color:var(--slate); padding:18px;">No weak topics this week — great job!</td></tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>

        <div class="card">
          <div class="card__head">
            <div><div class="card__title">LT History</div></div>
          </div>
          <div class="filters">
            <select class="filter-select"><option>Subject</option><option>Physics</option><option>Chemistry</option><option>Maths</option><option>Biology</option></select>
            <select class="filter-select"><option>Date</option></select>
            <select class="filter-select"><option>Score</option><option>Excellent</option><option>Better</option><option>Good</option></select>
            <select class="filter-select"><option>Week</option></select>
            <select class="filter-select"><option>Month</option></select>
          </div>
          <div class="table-wrap">
            <table>
              <thead><tr><th>LT No</th><th>Subject</th><th>Date</th><th>Score</th><th>Action</th></tr></thead>
              <tbody>
                <% data.lt.history.forEach(function(h){ %>
                  <tr>
                    <td class="num"><%= h.ltNo %></td><td><%= h.subject %></td><td class="num"><%= h.date %></td>
                    <td><span class="chip <%= h.score==='Excellent'?'chip-success':h.score==='Better'?'chip-neutral':'chip-warning' %>"><%= h.score %></span></td>
                    <td><button class="btn btn-ghost btn-sm" data-modal-open="topicModal<%= h.ltNo %>">View Topic</button></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>

      </div>
    </div>
  </div>

  <% [...data.lt.weakTopics, ...data.lt.history].forEach(function(item){ %>
    <div class="modal-overlay" id="topicModal<%= item.ltNo %>" data-modal>
      <div class="modal-box">
        <div class="modal-box__head">
          <div><div class="card__title">LT #<%= item.ltNo %> — <%= item.subject %></div><div class="card__desc num"><%= item.date %></div></div>
          <button class="modal-close" data-modal-close>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 6l12 12M18 6 6 18"/></svg>
          </button>
        </div>
        <div class="detail-panel__row"><span>Topic</span><span><%= item.topic %></span></div>
        <div class="detail-panel__row"><span>Score</span><span><%= item.score %></span></div>
      </div>
    </div>
  <% }) %>

  <%- include('../partials/scripts') %>
  <script>
    const levelMap = { Good: 1, Better: 2, Excellent: 3 };
    new Chart(document.getElementById('thisWeekChart'), {
      type: 'bar',
      data: {
        labels: <%- JSON.stringify(data.lt.thisWeek.map(t=>t.subject)) %>,
        datasets: [{
          data: <%- JSON.stringify(data.lt.thisWeek.map(t=>t.value)) %>,
          backgroundColor: <%- JSON.stringify(data.lt.thisWeek.map(t=> t.level==='Excellent' ? '#2F8F5B' : t.level==='Better' ? '#3D6FE0' : '#D99A2B')) %>,
          borderRadius: 6, maxBarThickness: 50
        }]
      },
      options: {
        plugins: { legend: { display:false } },
        scales: {
          y: { min:0, max:3, ticks: { stepSize:1, callback: (v)=>({0:'',1:'Good',2:'Better',3:'Excellent'})[v], font:{family:'Manrope', size:11} }, grid:{color:'#EEF0F8'} },
          x: { grid:{display:false}, ticks:{font:{family:'Manrope', weight:600}} }
        }
      }
    });

    new Chart(document.getElementById('growthRateChart'), {
      type: 'bar',
      data: {
        labels: <%- JSON.stringify(data.lt.growthRateByWeek.map(w=>w.week)) %>,
        datasets: [{ data: <%- JSON.stringify(data.lt.growthRateByWeek.map(w=>w.value)) %>,
          backgroundColor: '#3B4FE0', borderRadius:6, maxBarThickness:50 }]
      },
      options: {
        plugins: { legend: { display:false } },
        scales: { y:{beginAtZero:true, max:100, grid:{color:'#EEF0F8'}, ticks:{font:{family:'IBM Plex Mono'}}}, x:{grid:{display:false}, ticks:{font:{family:'Manrope', weight:600}}} }
      }
    });
  </script>
</body>
</html>

