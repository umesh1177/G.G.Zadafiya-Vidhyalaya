<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head', { title: 'Hall Ticket' }) %>
</head>
<body>
  <div class="app">
    <%- include('../partials/sidebar', { active: 'hallTicket', data: data }) %>

    <div class="main">
      <%- include('../partials/topbar', { title: 'Hall Ticket', subtitle: 'Download your hall ticket for upcoming exams', data: data }) %>

      <div class="content">

        <div class="card">
          <div class="card__head"><div class="card__title">Hall Ticket Table</div></div>
          <div class="table-wrap">
            <table>
              <thead><tr><th>Sr No</th><th>Standard</th><th>Date</th><th>Exam Type</th><th>Action</th></tr></thead>
              <tbody>
                <% data.hallTickets.forEach(function(h){ %>
                  <tr>
                    <td class="num"><%= h.srNo %></td><td class="num"><%= h.standard %></td><td class="num"><%= h.date %></td>
                    <td><span class="chip chip-neutral"><%= h.examType %></span></td>
                    <td class="flex gap-8"><button class="btn btn-ghost btn-sm">View</button><button class="btn btn-primary btn-sm">Download</button></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>

      </div>
    </div>
  </div>

  <%- include('../partials/scripts') %>
</body>
</html>

