<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head', { title: 'Exam Result' }) %>
</head>
<body>
  <div class="app">
    <%- include('../partials/sidebar', { active: 'examResult', data: data }) %>

    <div class="main">
      <%- include('../partials/topbar', { title: 'Exam Result', subtitle: 'Every exam, with your rank and percentile', data: data }) %>

      <div class="content">

        <div class="card">
          <div class="card__head"><div class="card__title">All Exam Marks</div></div>
          <div class="filters">
            <select class="filter-select"><option>Subject</option><option>Physics</option><option>Chemistry</option><option>Maths</option><option>Biology</option></select>
            <select class="filter-select"><option>Standard</option><option>11</option><option>12</option></select>
            <select class="filter-select"><option>Type</option><option>Board</option><option>GUJCET</option><option>JEE</option><option>NEET</option></select>
            <select class="filter-select"><option>Day</option></select>
            <select class="filter-select"><option>Date</option></select>
          </div>
          <div class="table-wrap">
            <table>
              <thead><tr><th>Sr No</th><th>Subject</th><th>Exam Date</th><th>Rank</th><th>Percentile</th><th>Score</th><th>Type</th></tr></thead>
              <tbody>
                <% data.examResults.forEach(function(e){ %>
                  <tr>
                    <td class="num"><%= e.srNo %></td><td><%= e.subject %></td><td class="num"><%= e.examDate %></td>
                    <td class="num">#<%= e.rank %></td><td class="num"><%= e.percentile %></td>
                    <td class="num"><%= e.score %>%</td><td><span class="chip chip-neutral"><%= e.type %></span></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>

      </div>
    </div>
  </div>

  <%- include('../partials/scripts') %>
</body>
</html>

