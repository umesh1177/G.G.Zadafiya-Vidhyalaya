<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head', { title: 'Discipline Remark' }) %>
</head>
<body>
  <div class="app">
    <%- include('../partials/sidebar', { active: 'discipline', data: data }) %>

    <div class="main">
      <%- include('../partials/topbar', { title: 'Discipline Remark', subtitle: 'Records noted by school staff', data: data }) %>

      <div class="content">

        <div class="card">
          <div class="card__head"><div class="card__title">History</div></div>
          <div class="filters">
            <select class="filter-select"><option>Recently</option></select>
            <select class="filter-select"><option>Type</option><option>Long hair</option><option>Come late</option></select>
          </div>
          <div class="table-wrap">
            <table>
              <thead><tr><th>Sr No</th><th>Type</th><th>Date</th><th>Noted By</th><th>Action</th></tr></thead>
              <tbody>
                <% data.disciplineHistory.forEach(function(d){ %>
                  <tr>
                    <td class="num"><%= d.srNo %></td><td><span class="chip chip-warning"><%= d.type %></span></td>
                    <td class="num"><%= d.date %></td><td><%= d.notedBy %></td>
                    <td><button class="btn btn-ghost btn-sm" data-modal-open="discModal<%= d.srNo %>">View Message</button></td>
                  </tr>
                <% }) %>
                <% if (data.disciplineHistory.length === 0) { %>
                  <tr><td colspan="5" style="text-align:center; color:var(--slate); padding:18px;">No discipline records — keep it up!</td></tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>

      </div>
    </div>
  </div>

  <% data.disciplineHistory.forEach(function(d){ %>
    <div class="modal-overlay" id="discModal<%= d.srNo %>" data-modal>
      <div class="modal-box">
        <div class="modal-box__head">
          <div><div class="card__title"><%= d.type %></div><div class="card__desc num"><%= d.date %> · Noted by <%= d.notedBy %></div></div>
          <button class="modal-close" data-modal-close>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 6l12 12M18 6 6 18"/></svg>
          </button>
        </div>
        <p style="font-size:13.6px; line-height:1.6;"><%= d.message %></p>
      </div>
    </div>
  <% }) %>

  <%- include('../partials/scripts') %>
</body>
</html>

