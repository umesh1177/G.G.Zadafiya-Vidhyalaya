<div class="sidebar-overlay"></div>
<aside class="sidebar">
  <div class="sidebar__brand">
    <div class="sidebar__logo">SV</div>
    <div>
      <div class="sidebar__school"><%= data.student.school %></div>
      <div class="sidebar__role">Parent / Student</div>
    </div>
  </div>

  <nav class="sidebar__nav">
    <a href="/student/" class="navlink <%= active === 'home' ? 'is-active' : '' %>">
      <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11.5 12 4l9 7.5"/><path d="M5 10v10h14V10"/><path d="M9.5 20v-6h5v6"/></svg>
      Home
    </a>

    <div class="sidebar__group-label">Performance</div>

    <a href="/student/lt-analysis" class="navlink <%= active === 'ltAnalysis' ? 'is-active' : '' %>">
      <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/></svg>
      LT Analysis
    </a>

    <a href="/student/progress-report" class="navlink <%= active === 'progressReport' ? 'is-active' : '' %>">
      <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19V5M4 19h16"/><path d="m6.5 15 3.5-4 3 2.4L18 8.5"/></svg>
      Progress Report
    </a>

    <a href="/student/exam-result" class="navlink <%= active === 'examResult' ? 'is-active' : '' %>">
      <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3.5" y="3.5" width="17" height="17" rx="2.4"/><path d="M8 14v3M12 10.5V17M16 12.5V17"/></svg>
      Exam Result
    </a>

    <a href="/student/result" class="navlink <%= active === 'result' ? 'is-active' : '' %>">
      <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 3.5h7l3.5 3.5V20a.6.6 0 0 1-.6.6H7a.6.6 0 0 1-.6-.6V4.1A.6.6 0 0 1 7 3.5Z"/><path d="M14 3.5V7h3.5"/><path d="M9 12h6M9 15.3h6M9 8.7h3"/></svg>
      Result
    </a>

    <a href="/student/hall-ticket" class="navlink <%= active === 'hallTicket' ? 'is-active' : '' %>">
      <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3.5" y="6" width="17" height="12" rx="2"/><path d="M3.5 10.5h17M8 14h3"/></svg>
      Hall Ticket
    </a>

    <div class="sidebar__group-label">Communication</div>

    <a href="/student/notice-message" class="navlink <%= active === 'notice' ? 'is-active' : '' %>">
      <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.5 18.5a2 2 0 0 0 3.7 0"/><path d="M5 17h13.5c-1.4-1.3-2.2-3-2.2-5.6V9.2A5.3 5.3 0 0 0 11 4a5.3 5.3 0 0 0-5.3 5.2v2.2C5.7 14 4.9 15.7 5 17Z"/></svg>
      Notice Message
    </a>

    <a href="/student/discipline-remark" class="navlink <%= active === 'discipline' ? 'is-active' : '' %>">
      <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3.8 4 7.4v5.1c0 4.2 3.3 7.9 8 8.7 4.7-.8 8-4.5 8-8.7V7.4Z"/><path d="M12 8.4v4M12 15.4h.01"/></svg>
      Discipline Remark
    </a>

    <a href="/student/logout" class="navlink is-logout">
      <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 4.5H6.4A1.9 1.9 0 0 0 4.5 6.4v11.2a1.9 1.9 0 0 0 1.9 1.9H9"/><path d="M15.5 16.5 20 12l-4.5-4.5M20 12H9"/></svg>
      Logout
    </a>
  </nav>

  <div class="sidebar__footer">Roll No <%= data.student.rollNo %> • Std <%= data.student.standard %></div>
</aside>

