<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head', { title: 'Profile' }) %>
  <style>
    /* Premium Profile Styles */
    .profile-hero {
      position: relative;
      border-radius: var(--radius-lg);
      background: linear-gradient(135deg, var(--indigo) 0%, #6875F5 100%);
      padding: 32px;
      color: #ffffff;
      margin-bottom: 24px;
      overflow: hidden;
      display: flex;
      align-items: center;
      gap: 24px;
      box-shadow: 0 4px 20px rgba(59, 79, 224, 0.15);
    }
    
    .profile-hero::before {
      content: "";
      position: absolute;
      top: -50%;
      right: -20%;
      width: 300px;
      height: 300px;
      background: rgba(255, 255, 255, 0.08);
      border-radius: 50%;
      pointer-events: none;
    }
    
    .profile-hero__avatar-container {
      position: relative;
      width: 120px;
      height: 120px;
      border-radius: 50%;
      padding: 4px;
      background: rgba(255, 255, 255, 0.25);
      backdrop-filter: blur(8px);
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.15);
      flex-shrink: 0;
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    
    .profile-hero__avatar-container:hover {
      transform: scale(1.04);
      box-shadow: 0 12px 40px rgba(0, 0, 0, 0.2);
    }
    
    .profile-hero__avatar {
      width: 100%;
      height: 100%;
      border-radius: 50%;
      object-fit: cover;
      border: 3px solid #ffffff;
      background: var(--indigo-soft);
    }
    
    .profile-hero__details h2 {
      color: #ffffff;
      font-size: 24px;
      font-weight: 700;
      margin: 0 0 6px 0;
      letter-spacing: -0.02em;
    }
    
    .profile-hero__role-badge {
      display: inline-flex;
      align-items: center;
      padding: 4px 12px;
      background: rgba(255, 255, 255, 0.18);
      border-radius: 99px;
      font-size: 12.5px;
      font-weight: 600;
      letter-spacing: 0.02em;
      border: 1px solid rgba(255, 255, 255, 0.25);
      margin-bottom: 8px;
    }
    
    .profile-hero__details {
      min-width: 0;
    }
    
    .profile-hero__school {
      font-size: 13.5px;
      opacity: 0.9;
      display: flex;
      align-items: flex-start;
      gap: 6px;
    }
    
    .profile-hero__school svg {
      width: 16px;
      height: 16px;
      stroke: currentColor;
      flex-shrink: 0;
      margin-top: 2px;
    }
    
    .profile-hero__school span {
      word-break: break-word;
      text-align: left;
    }
    
    .info-card {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-card);
      padding: 24px;
      margin-bottom: 24px;
    }
    
    .info-card__title {
      font-size: 16.5px;
      font-weight: 700;
      margin-bottom: 20px;
      color: var(--ink);
      border-bottom: 1px solid var(--line-soft);
      padding-bottom: 12px;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    
    .info-card__title svg {
      width: 18px;
      height: 18px;
      stroke: var(--indigo);
    }
    
    .profile-grid-fields {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
      gap: 20px;
    }
    
    @media (max-width: 768px) {
      .profile-hero {
        flex-direction: column;
        text-align: center;
        padding: 24px;
      }
      .profile-hero__school {
        justify-content: center;
      }
      .profile-hero__school span {
        text-align: center;
      }
    }
    
    @media (max-width: 520px) {
      .profile-hero {
        padding: 20px 16px;
        gap: 16px;
      }
      .profile-hero__avatar-container {
        width: 100px;
        height: 100px;
      }
      .profile-hero__details h2 {
        font-size: 20px;
      }
      .info-card {
        padding: 16px;
      }
      .profile-field__value-wrapper {
        padding: 10px 12px;
        gap: 8px;
      }
      .profile-field__value {
        font-size: 13.5px;
      }
      .read-only-banner {
        padding: 12px;
        gap: 10px;
      }
    }
    
    .profile-field {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    
    .profile-field__label {
      font-size: 11.5px;
      font-weight: 700;
      color: var(--slate);
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    
    .profile-field__value-wrapper {
      display: flex;
      align-items: center;
      background: var(--indigo-softer);
      border: 1px solid var(--indigo-soft);
      border-radius: var(--radius-sm);
      padding: 11px 14px;
      gap: 10px;
      min-height: 44px;
      transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }
    
    .profile-field__value-wrapper:hover {
      border-color: rgba(59, 79, 224, 0.3);
      box-shadow: 0 2px 8px rgba(59, 79, 224, 0.05);
    }
    
    .profile-field__icon {
      width: 18px;
      height: 18px;
      stroke: var(--slate);
      flex-shrink: 0;
    }
    
    .profile-field__value {
      font-size: 14px;
      font-weight: 600;
      color: var(--ink-soft);
      flex: 1;
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    
    .profile-field__value.mono {
      font-family: var(--font-mono);
      font-size: 13.5px;
      letter-spacing: 0.02em;
    }
    
    .password-toggle-btn {
      background: none;
      border: none;
      padding: 4px;
      cursor: pointer;
      color: var(--slate);
      display:flex;
      align-items:center;
      justify-content:center;
      transition: color 0.15s ease, transform 0.15s ease;
      border-radius: 4px;
    }
    
    .password-toggle-btn:hover {
      color: var(--indigo);
      transform: scale(1.08);
      background: var(--indigo-soft);
    }
    
    .password-toggle-btn svg {
      width: 16px;
      height: 16px;
      stroke: currentColor;
    }
    
    .read-only-banner {
      display: flex;
      gap: 14px;
      align-items: flex-start;
      background: var(--warning-soft);
      border: 1px dashed var(--warning);
      border-radius: var(--radius-md);
      padding: 16px;
      margin-top: 10px;
    }
    
    .read-only-banner svg {
      width: 20px;
      height: 20px;
      stroke: var(--warning);
      flex-shrink: 0;
      margin-top: 2px;
    }
    
    .read-only-banner__content {
      font-size: 13px;
      color: #9c6f1c;
      line-height: 1.5;
    }
    
    .read-only-banner__title {
      font-weight: 700;
      margin-bottom: 3px;
    }
  </style>
</head>
<body>
  <div class="app">
    <%- include('../partials/sidebar', { active: 'profile', data: data }) %>

    <div class="main">
      <%- include('../partials/topbar', { title: 'Faculty Profile', subtitle: 'View official account and system credentials', data: data }) %>

      <div class="content">
        <!-- Hero section with Profile Avatar and Core Details -->
        <div class="profile-hero">
          <div class="profile-hero__avatar-container">
            <% if (data.faculty.photo) { %>
              <img src="<%= data.faculty.photo %>" class="profile-hero__avatar" alt="<%= data.faculty.name %>">
            <% } else { %>
              <div class="profile-hero__avatar" style="display:flex; align-items:center; justify-content:center; font-size:32px; font-weight:700; font-family:var(--font-display); background:var(--indigo-dark); color:#fff;"><%= data.faculty.initials %></div>
            <% } %>
          </div>
          <div class="profile-hero__details">
            <span class="profile-hero__role-badge"><%= data.faculty.role %></span>
            <h2><%= data.faculty.name %></h2>
            <div class="profile-hero__school">
              <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c0 2 2 3 6 3s6-1 6-3v-5"/></svg>
              <span><%= data.faculty.school %></span>
            </div>
          </div>
        </div>

        <div class="grid-2">
          <!-- Left Column: Personal and Academic Info -->
          <div class="info-card">
            <div class="info-card__title">
              <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M16 13H8M16 17H8M10 9H8"/></svg>
              Official Profile Details
            </div>
            
            <div class="profile-grid-fields">
              <!-- Full Name -->
              <div class="profile-field">
                <span class="profile-field__label">Full Name</span>
                <div class="profile-field__value-wrapper">
                  <svg class="profile-field__icon" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                  <span class="profile-field__value"><%= data.faculty.name %></span>
                </div>
              </div>

              <!-- Email Address -->
              <div class="profile-field">
                <span class="profile-field__label">Email Address</span>
                <div class="profile-field__value-wrapper">
                  <svg class="profile-field__icon" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><path d="M22 6l-10 7L2 6"/></svg>
                  <span class="profile-field__value"><%= data.faculty.email %></span>
                </div>
              </div>

              <!-- Contact No -->
              <div class="profile-field">
                <span class="profile-field__label">Contact Number</span>
                <div class="profile-field__value-wrapper">
                  <svg class="profile-field__icon" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                  <span class="profile-field__value mono"><%= data.faculty.contactNo %></span>
                </div>
              </div>

              <!-- Subject Specification -->
              <div class="profile-field">
                <span class="profile-field__label">Assigned Subject</span>
                <div class="profile-field__value-wrapper">
                  <svg class="profile-field__icon" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20M4 4.5A2.5 2.5 0 0 1 6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5z"/></svg>
                  <span class="profile-field__value"><%= data.faculty.subject %></span>
                </div>
              </div>

              <!-- Designation Role -->
              <div class="profile-field">
                <span class="profile-field__label">Designation Role</span>
                <div class="profile-field__value-wrapper">
                  <svg class="profile-field__icon" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                  <span class="profile-field__value"><%= data.faculty.role %></span>
                </div>
              </div>

              <!-- Joining Date -->
              <div class="profile-field">
                <span class="profile-field__label">Joining Date</span>
                <div class="profile-field__value-wrapper">
                  <svg class="profile-field__icon" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                  <span class="profile-field__value mono"><%= data.faculty.joiningDate %></span>
                </div>
              </div>
            </div>
          </div>

          <!-- Right Column: Credentials & Security Info -->
          <div style="display:flex; flex-direction:column; gap:20px;">
            <div class="info-card" style="margin-bottom:0;">
              <div class="info-card__title">
                <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                System Credentials
              </div>
              
              <div style="display:flex; flex-direction:column; gap:16px;">
                <!-- Username -->
                <div class="profile-field">
                  <span class="profile-field__label">Username</span>
                  <div class="profile-field__value-wrapper">
                    <svg class="profile-field__icon" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" y1="22" x2="4" y2="15"/></svg>
                    <span class="profile-field__value mono"><%= data.faculty.username %></span>
                  </div>
                </div>

                <!-- Password -->
                <div class="profile-field">
                  <span class="profile-field__label">Portal Password</span>
                  <div class="profile-field__value-wrapper">
                    <svg class="profile-field__icon" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.778-7.778zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/></svg>
                    <span class="profile-field__value mono" id="faculty-password" data-masked="true">••••••••</span>
                    <button class="password-toggle-btn" id="pwd-toggle-btn" onclick="togglePassword()" aria-label="Show password">
                      <!-- Eye Icon -->
                      <svg id="eye-icon" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                      <!-- Eye Off Icon -->
                      <svg id="eye-off-icon" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none;"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
                    </button>
                  </div>
                </div>
              </div>
            </div>

            <!-- Lock and Read-only notice banner -->
            <div class="read-only-banner">
              <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              <div class="read-only-banner__content">
                <div class="read-only-banner__title">Security Notice</div>
                Account details are verified and managed by school administration. Self-service profile updates are disabled for security compliance. If you need to update your details, please contact the IT support desk.
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>

  <%- include('../partials/scripts') %>
  
  <script>
    function togglePassword() {
      const pwdText = document.getElementById('faculty-password');
      const toggleBtn = document.getElementById('pwd-toggle-btn');
      const eyeIcon = document.getElementById('eye-icon');
      const eyeOffIcon = document.getElementById('eye-off-icon');
      
      if (pwdText.dataset.masked === 'true') {
        pwdText.textContent = '<%= data.faculty.password %>';
        pwdText.dataset.masked = 'false';
        eyeIcon.style.display = 'none';
        eyeOffIcon.style.display = 'inline';
        toggleBtn.setAttribute('aria-label', 'Hide password');
      } else {
        pwdText.textContent = '••••••••';
        pwdText.dataset.masked = 'true';
        eyeIcon.style.display = 'inline';
        eyeOffIcon.style.display = 'none';
        toggleBtn.setAttribute('aria-label', 'Show password');
      }
    }
  </script>
</body>
</html>

