<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head', { title: 'Exam Unit' }) %>
</head>
<body>
  <div class="app">
    <%- include('../partials/sidebar', { active: 'examUnit', data: data }) %>

    <div class="main">
      <%- include('../partials/topbar', { title: 'Exam Unit', subtitle: 'Select syllabus coverage for the next exam, or review past exams', data: data }) %>

      <div class="content">

        <div class="tabs" data-tab-group="examUnitTabs">
          <button class="tab-btn is-active" data-tab-target="select-unit">Select Unit for Exam</button>
          <button class="tab-btn" data-tab-target="exam-history">Exam History</button>
        </div>

        <!-- SELECT UNIT -->
        <div class="tab-panel is-active" data-tab-panel="select-unit" data-tab-family="examUnitTabs">
          <div class="grid-2">
            <div class="card">
              <div class="card__title" style="margin-bottom:14px;">Chapters &amp; Topics</div>
              <div class="chapter-accordion">
                <% data.chapters.forEach(function(ch, idx){ %>
                  <div class="chapter-item <%= idx===0 ? 'is-open' : '' %>">
                    <div class="chapter-header">
                      <span class="chapter-header__title"><%= ch.chapterNo %>. <%= ch.chapterName %></span>
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
                    </div>
                    <div class="chapter-topics">
                      <% ch.topics.forEach(function(t){ %>
                        <% var unitLabel = 'Ch ' + ch.chapterNo + ' (' + ch.chapterName + ') — Till ' + t.topicNo; %>
                        <div class="topic-row">
                          <div class="topic-row__name">
                            <span class="topic-row__num"><%= t.topicNo %></span><span><%= t.name %></span>
                          </div>
                          <div class="topic-actions">
                            <button type="button" class="btn btn-ghost btn-sm btn-add-exam-unit" data-unit="<%= unitLabel %>">Till <%= t.topicNo %></button>
                          </div>
                        </div>
                      <% }) %>
                      <% var chLabel = 'Ch ' + ch.chapterNo + ' (' + ch.chapterName + ') — All topics'; %>
                      <button type="button" class="btn btn-ghost btn-sm all-topics-btn btn-add-exam-unit" data-unit="<%= chLabel %>">All topics</button>
                    </div>
                  </div>
                <% }) %>
              </div>
            </div>

            <div class="card">
              <div class="card__title" style="margin-bottom:14px;">Exam Table</div>
              <div class="detail-panel" style="margin-bottom:16px;">
                <div class="detail-panel__row" style="flex-direction: column; align-items: stretch; border-bottom: none;">
                  <span style="margin-bottom: 8px;">Selected Units/Chapters</span>
                  <div id="selectedExamUnitsList" class="added-list" style="margin: 0;"></div>
                  <div id="selectedExamUnitsEmpty" class="detail-panel__empty" style="padding: 10px 0; text-align: left;">None selected yet</div>
                </div>
              </div>

              <form onsubmit="return false;">
                <div style="margin-bottom:12px;"><label class="field-label">Date</label><input type="date" class="field-input w-full"></div>
                <div style="margin-bottom:12px;">
                  <label class="field-label">Type</label>
                  <select class="filter-select w-full"><option>Weekly</option><option>Monthly</option><option>Annual</option></select>
                </div>
                <div style="margin-bottom:16px;">
                  <label class="field-label">Subject</label>
                  <select class="filter-select w-full">
                    <option <%= data.faculty.subject === 'Physics' ? 'selected' : '' %>>Physics</option>
                    <option <%= data.faculty.subject === 'Chemistry' ? 'selected' : '' %>>Chemistry</option>
                    <option <%= data.faculty.subject === 'Mathematics' ? 'selected' : '' %>>Mathematics</option>
                    <option <%= data.faculty.subject === 'Biology' ? 'selected' : '' %>>Biology</option>
                  </select>
                </div>
                <button class="btn btn-primary btn-block" type="submit">Submit</button>
              </form>
            </div>
          </div>
        </div>

        <!-- EXAM HISTORY -->
        <div class="tab-panel" data-tab-panel="exam-history" data-tab-family="examUnitTabs">
          <div class="card">
            <div class="card__title" style="margin-bottom:14px;">Exam History</div>
            <div class="table-wrap">
              <table>
                <thead><tr><th>Sr No</th><th>Date</th><th>Type</th><th>Unit</th></tr></thead>
                <tbody>
                  <% data.examHistory.forEach(function(e){ %>
                    <tr><td class="num"><%= e.srNo %></td><td class="num"><%= e.date %></td><td><span class="chip chip-neutral"><%= e.type %></span></td><td><%= e.unit %></td></tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>

  <%- include('../partials/scripts') %>
</body>
</html>

