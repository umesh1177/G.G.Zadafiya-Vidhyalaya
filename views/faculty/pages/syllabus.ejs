<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head', { title: 'Syllabus' }) %>
</head>
<body>
  <div class="app">
    <%- include('../partials/sidebar', { active: 'syllabus', data: data }) %>

    <div class="main">
      <%- include('../partials/topbar', { title: 'Syllabus', subtitle: 'Mark topics complete as you teach them — the Principal sees this live', data: data }) %>

      <div class="content">

        <div class="kpi-grid">
          <div class="kpi-card"><div class="kpi-card__label">Total Chapters</div><div class="kpi-card__value num"><%= data.syllabusStats.totalChapters %></div></div>
          <div class="kpi-card is-success"><div class="kpi-card__label">Completed</div><div class="kpi-card__value num"><%= data.syllabusStats.completed %></div></div>
          <div class="kpi-card is-warning"><div class="kpi-card__label">Pending</div><div class="kpi-card__value num"><%= data.syllabusStats.pending %></div></div>
        </div>

        <div class="card">
          <div class="card__head">
            <div>
              <div class="card__title">Syllabus Menu — <%= data.faculty.subject %></div>
              <div class="card__desc">Click a chapter to expand, then click "Finish" on each topic as you complete it</div>
            </div>
          </div>

          <div class="chapter-accordion">
            <% data.chapters.forEach(function(ch, idx){ %>
              <% var doneCount = ch.topics.filter(t=>t.status==='done').length; %>
              <div class="chapter-item <%= idx===0 ? 'is-open' : '' %>">
                <div class="chapter-header">
                  <span class="chapter-header__title"><%= ch.chapterNo %>. <%= ch.chapterName %></span>
                  <span class="flex items-center gap-12">
                    <span class="chapter-header__meta"><%= doneCount %>/<%= ch.topics.length %> done</span>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
                  </span>
                </div>
                <div class="chapter-topics">
                  <% ch.topics.forEach(function(t){ %>
                    <div class="topic-row">
                      <div class="topic-row__name">
                        <span class="topic-row__num"><%= t.topicNo %></span>
                        <span><%= t.name %></span>
                        <span class="chip topic-status <%= t.status==='done' ? 'chip-success' : 'chip-warning' %>"><%= t.status==='done' ? 'Done' : 'Pending' %></span>
                      </div>
                      <div class="topic-actions">
                        <button type="button" class="btn btn-ghost btn-sm btn-finish <%= t.status==='done' ? 'is-done' : '' %>"><%= t.status==='done' ? 'Done ✓' : 'Finish' %></button>
                      </div>
                    </div>
                  <% }) %>
                </div>
              </div>
            <% }) %>
          </div>
        </div>

      </div>
    </div>
  </div>

  <%- include('../partials/scripts') %>
</body>
</html>

