<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sign In — SVVS School Dashboard</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=Manrope:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@500;600;700&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg:          #0d0f14;
      --surface:     #13161e;
      --surface2:    #1a1e28;
      --border:      rgba(255,255,255,0.08);
      --ink:         #f0f2f8;
      --ink-soft:    #9ba3b8;
      --ink-faint:   #5a6278;
      --indigo:      #6c7cff;
      --indigo-dark: #4c5de0;
      --indigo-soft: rgba(108,124,255,0.12);
      --success:     #22c55e;
      --warning:     #f59e0b;
      --error:       #ef4444;
      --error-soft:  rgba(239,68,68,0.12);
    }

    html, body {
      height: 100%;
      font-family: 'Manrope', sans-serif;
      background: var(--bg);
      color: var(--ink);
      overflow: hidden;
    }

    /* Animated background */
    .bg-orbs {
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 0;
      overflow: hidden;
    }
    .bg-orbs::before {
      content: '';
      position: absolute;
      width: 600px; height: 600px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(108,124,255,0.15) 0%, transparent 70%);
      top: -200px; left: -200px;
      animation: orb1 18s ease-in-out infinite;
    }
    .bg-orbs::after {
      content: '';
      position: absolute;
      width: 500px; height: 500px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(34,197,94,0.08) 0%, transparent 70%);
      bottom: -150px; right: -150px;
      animation: orb2 22s ease-in-out infinite;
    }
    @keyframes orb1 { 0%,100%{transform:translate(0,0)} 50%{transform:translate(80px,60px)} }
    @keyframes orb2 { 0%,100%{transform:translate(0,0)} 50%{transform:translate(-60px,-80px)} }

    .login-wrap {
      position: relative;
      z-index: 1;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    .login-card {
      width: 100%;
      max-width: 420px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 40px 36px;
      box-shadow: 0 24px 64px rgba(0,0,0,0.6), 0 0 0 1px rgba(255,255,255,0.04);
      animation: slideUp 0.5s cubic-bezier(0.16,1,0.3,1) both;
    }
    @keyframes slideUp {
      from { opacity: 0; transform: translateY(28px) scale(0.97); }
      to   { opacity: 1; transform: translateY(0) scale(1); }
    }

    /* Brand */
    .brand {
      display: flex;
      align-items: center;
      gap: 14px;
      margin-bottom: 32px;
    }
    .brand__logo {
      width: 48px; height: 48px;
      border-radius: 14px;
      background: linear-gradient(135deg, var(--indigo) 0%, #8b5cf6 100%);
      display: flex; align-items: center; justify-content: center;
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 700; font-size: 18px;
      color: #fff;
      box-shadow: 0 8px 24px rgba(108,124,255,0.3);
      flex-shrink: 0;
    }
    .brand__name {
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 700;
      font-size: 15px;
      color: var(--ink);
      line-height: 1.3;
    }
    .brand__sub {
      font-size: 11.5px;
      color: var(--ink-faint);
      margin-top: 2px;
    }

    /* Heading */
    .login-title {
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 700;
      font-size: 22px;
      color: var(--ink);
      margin-bottom: 6px;
    }
    .login-sub {
      font-size: 13px;
      color: var(--ink-soft);
      margin-bottom: 28px;
    }

    /* Error banner */
    .error-banner {
      background: var(--error-soft);
      border: 1px solid rgba(239,68,68,0.25);
      border-radius: 10px;
      padding: 11px 14px;
      font-size: 13px;
      color: #f87171;
      margin-bottom: 20px;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .error-banner svg { flex-shrink: 0; }

    /* Form */
    .form-group { margin-bottom: 18px; }
    label {
      display: block;
      font-size: 12px;
      font-weight: 600;
      color: var(--ink-soft);
      margin-bottom: 7px;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }
    input[type="text"], input[type="password"] {
      width: 100%;
      background: var(--surface2);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 12px 14px;
      font-size: 14px;
      font-family: 'Manrope', sans-serif;
      color: var(--ink);
      outline: none;
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    input[type="text"]::placeholder, input[type="password"]::placeholder {
      color: var(--ink-faint);
    }
    input[type="text"]:focus, input[type="password"]:focus {
      border-color: var(--indigo);
      box-shadow: 0 0 0 3px var(--indigo-soft);
    }

    /* Submit button */
    .btn-login {
      width: 100%;
      background: linear-gradient(135deg, var(--indigo) 0%, #8b5cf6 100%);
      color: #fff;
      border: none;
      border-radius: 10px;
      padding: 13px;
      font-size: 14.5px;
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 600;
      cursor: pointer;
      transition: opacity 0.2s, transform 0.15s;
      margin-top: 8px;
      box-shadow: 0 8px 24px rgba(108,124,255,0.25);
    }
    .btn-login:hover { opacity: 0.9; transform: translateY(-1px); }
    .btn-login:active { transform: translateY(0); }

    /* Role hints */
    .role-hints {
      margin-top: 28px;
      padding-top: 22px;
      border-top: 1px solid var(--border);
    }
    .role-hints__title {
      font-size: 11.5px;
      font-weight: 600;
      color: var(--ink-faint);
      text-transform: uppercase;
      letter-spacing: 0.06em;
      margin-bottom: 14px;
    }
    .role-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
    }
    .role-card {
      background: var(--surface2);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 10px 12px;
      cursor: pointer;
      transition: border-color 0.2s, background 0.2s;
    }
    .role-card:hover {
      border-color: var(--indigo);
      background: var(--indigo-soft);
    }
    .role-card__name {
      font-size: 12px;
      font-weight: 700;
      color: var(--ink);
      margin-bottom: 4px;
    }
    .role-card__cred {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 10.5px;
      color: var(--ink-faint);
      line-height: 1.6;
    }
    .role-card__cred span {
      color: var(--indigo);
    }
  </style>
</head>
<body>
  <div class="bg-orbs"></div>
  <div class="login-wrap">
    <div class="login-card">

      <div class="brand">
        <div class="brand__logo">SV</div>
        <div>
          <div class="brand__name">Shree Vidya Vihar Science School</div>
          <div class="brand__sub">Std 11–12 • Science Stream • GSEB</div>
        </div>
      </div>

      <div class="login-title">Welcome back 👋</div>
      <div class="login-sub">Sign in to access your dashboard</div>

      <% if (error) { %>
      <div class="error-banner">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>
        <%= error %>
      </div>
      <% } %>

      <form method="POST" action="/login" id="loginForm">
        <div class="form-group">
          <label for="username">Username</label>
          <input type="text" id="username" name="username" placeholder="Enter your username" autocomplete="username" required>
        </div>
        <div class="form-group">
          <label for="password">Password</label>
          <input type="password" id="password" name="password" placeholder="Enter your password" autocomplete="current-password" required>
        </div>
        <button type="submit" class="btn-login">Sign In →</button>
      </form>

      <div class="role-hints">
        <div class="role-hints__title">Quick Login — Demo Credentials</div>
        <div class="role-grid">
          <div class="role-card" onclick="fillCredentials('admin','admin123')">
            <div class="role-card__name">🎓 Principal</div>
            <div class="role-card__cred"><span>admin</span> / admin123</div>
          </div>
          <div class="role-card" onclick="fillCredentials('faculty','faculty123')">
            <div class="role-card__name">📚 Faculty</div>
            <div class="role-card__cred"><span>faculty</span> / faculty123</div>
          </div>
          <div class="role-card" onclick="fillCredentials('assistant','asst123')">
            <div class="role-card__name">🔬 Asst. Faculty</div>
            <div class="role-card__cred"><span>assistant</span> / asst123</div>
          </div>
          <div class="role-card" onclick="fillCredentials('student','student123')">
            <div class="role-card__name">🎒 Student</div>
            <div class="role-card__cred"><span>student</span> / student123</div>
          </div>
        </div>
      </div>

    </div>
  </div>

  <script>
    function fillCredentials(user, pass) {
      document.getElementById('username').value = user;
      document.getElementById('password').value = pass;
      document.getElementById('loginForm').submit();
    }
  </script>
</body>
</html>
