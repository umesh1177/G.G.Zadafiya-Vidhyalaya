<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head', { title: 'Home' }) %>
</head>
<body>
  <div class="app">
    <%- include('../partials/sidebar', { active: 'home', data: data }) %>

    <div class="main">
      <%- include('../partials/topbar', { title: 'Good morning, ' + data.assistant.name, subtitle: 'Here\'s what needs your attention today', data: data }) %>

      <div class="content">

        <div class="kpi-grid">
          <div class="kpi-card is-warning">
            <div class="kpi-card__label">Pending LT (Marks)</div>
            <div class="kpi-card__value num"><%= data.homeStats.pendingLT %></div>
            <div class="kpi-card__hint">Awaiting score entry</div>
          </div>
          <div class="kpi-card is-warning">
            <div class="kpi-card__label">Pending Exam Marks</div>
            <div class="kpi-card__value num"><%= data.homeStats.pendingExamMarks %></div>
            <div class="kpi-card__hint">Exams conducted, not yet entered</div>
          </div>
          <div class="kpi-card is-success">
            <div class="kpi-card__label">Hall Tickets Generated</div>
            <div class="kpi-card__value num"><%= data.homeStats.hallTicketsGenerated %></div>
            <div class="kpi-card__hint">This term</div>
          </div>
          <div class="kpi-card">
            <div class="kpi-card__label">Open Discipline Notes</div>
            <div class="kpi-card__value num"><%= data.homeStats.openDisciplineNotes %></div>
            <div class="kpi-card__hint">Logged by you</div>
          </div>
        </div>

        <div class="banner banner-warning">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 9v4M12 16.5h.01"/><path d="M10.3 3.9 2.7 17.5a1.6 1.6 0 0 0 1.4 2.4h16a1.6 1.6 0 0 0 1.4-2.4L13.7 3.9a1.6 1.6 0 0 0-2.8 0Z"/></svg>
          <span><%= data.homeStats.pendingExamMarks %> exam(s) and <%= data.homeStats.pendingLT %> LT are waiting on marks entry — see Exam and LT for details.</span>
        </div>

        <div class="grid-2">
          <div class="card">
            <div class="card__head">
              <div>
                <div class="card__title">Today's LT</div>
                <div class="card__desc"><%= data.lt.today.subject %> · <%= data.lt.today.topic %></div>
              </div>
              <a href="/assistant/lt" class="btn btn-primary btn-sm">Open LT</a>
            </div>
            <div class="detail-panel">
              <div class="detail-panel__row"><span>Subject</span><span><%= data.lt.today.subject %></span></div>
              <div class="detail-panel__row"><span>Date</span><span class="num"><%= data.lt.today.date %></span></div>
              <div class="detail-panel__row"><span>Type</span><span><%= data.lt.today.type %></span></div>
              <div class="detail-panel__row"><span>Topic</span><span><%= data.lt.today.topic %></span></div>
            </div>
          </div>

          <div class="card">
            <div class="card__head">
              <div>
                <div class="card__title">Recent Notices</div>
                <div class="card__desc">Latest messages from the Principal</div>
              </div>
              <a href="/assistant/notice" class="btn btn-ghost btn-sm">View all</a>
            </div>
            <ul>
              <% data.notices.slice(0,3).forEach(function(n){ %>
                <li style="padding:10px 0; border-bottom:1px solid var(--line-soft);">
                  <div class="text-slate num" style="font-size:11.5px; margin-bottom:4px;"><%= n.date %></div>
                  <div style="font-size:13px; color:var(--ink-soft);"><%= n.message.length > 90 ? n.message.slice(0,90)+'…' : n.message %></div>
                </li>
              <% }) %>
            </ul>
          </div>
        </div>

        <div class="card">
          <div class="card__head">
            <div>
              <div class="card__title">Recent Discipline Notes</div>
              <div class="card__desc">Logged by you, most recent first</div>
            </div>
            <a href="/assistant/discipline-remark" class="btn btn-ghost btn-sm">View all</a>
          </div>
          <div class="table-wrap">
            <table>
              <thead><tr><th>Roll No</th><th>Name</th><th>Type</th><th>Date</th></tr></thead>
              <tbody>
                <% data.disciplineHistory.forEach(function(d){ %>
                  <tr><td class="num"><%= d.rollNo %></td><td><%= d.name %></td><td><span class="chip chip-warning"><%= d.type %></span></td><td class="num"><%= d.date %></td></tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>

      </div>
    </div>
  </div>

  <%- include('../partials/scripts') %>
</body>
</html>

