<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head', { title: 'Hall Ticket Generation' }) %>
</head>
<body>
  <div class="app">
    <%- include('../partials/sidebar', { active: 'hallTicket', data: data }) %>

    <div class="main">
      <%- include('../partials/topbar', {
        title: 'Hall Ticket Generation',
        subtitle: 'Generate, publish, download and view hall ticket generation records',
        data: data
      }) %>

      <div class="content">

        <!-- Navigation Tabs -->
        <div class="tabs" data-tab-group="hallTicketTabs">
          <button class="tab-btn is-active" data-tab-target="generate-new">Generate New Hall Ticket</button>
          <button class="tab-btn" data-tab-target="history">Hall Ticket History</button>
        </div>

        <!-- ============================================================ GENERATE NEW HALL TICKET PANEL -->
        <div class="tab-panel is-active" data-tab-panel="generate-new" data-tab-family="hallTicketTabs">
          
          <div class="card">
            <div class="card__title" style="margin-bottom:16px;">Hall Ticket Setup</div>
            <div class="form-grid" style="margin-bottom:16px;">
              <div><label class="field-label">Standard</label><select class="filter-select w-full"><option>11</option><option>12</option></select></div>
              <div><label class="field-label">Exam Type</label><select class="filter-select w-full"><option>Board</option><option>GUJCET</option><option>JEE</option><option>NEET</option></select></div>
            </div>

            <label class="field-label">Add Subject in Hall Ticket</label>
            <div class="step-row">
              <select class="filter-select" data-field-for="hallTicketSubjectList-subject" style="min-width: 180px;">
                <option value="">Select Subject</option>
                <option value="Physics">Physics</option>
                <option value="Chemistry">Chemistry</option>
                <option value="Maths">Maths</option>
                <option value="Biology">Biology</option>
                <option value="English">English</option>
                <option value="Computer">Computer</option>
              </select>
              <input type="date" class="field-input" data-field-for="hallTicketSubjectList-date" style="max-width:180px;">
              <button type="button" class="btn btn-ghost btn-sm" data-add-chip="hallTicketSubjectList">+ Add</button>
            </div>
            <div id="hallTicketSubjectList" class="added-list">
              <div class="added-chip"><span>Physics — 19 May 2026</span><button type="button" aria-label="Remove">&times;</button></div>
              <div class="added-chip"><span>Chemistry — 20 May 2026</span><button type="button" aria-label="Remove">&times;</button></div>
              <div class="added-chip"><span>Maths — 21 May 2026</span><button type="button" aria-label="Remove">&times;</button></div>
            </div>

            <div class="form-grid" style="margin: 16px 0;">
              <div><label class="field-label">Upload Format</label><div class="upload-box">Click or drag a file here</div></div>
            </div>

            <button class="btn btn-primary">Generate Hall Ticket</button>
          </div>

          <div class="card">
            <div class="card__head">
              <div class="card__title">Generated Hall Ticket List</div>
              <div class="flex gap-8">
                <button class="btn btn-ghost btn-sm">Publish All</button>
                <button class="btn btn-ghost btn-sm">Download All</button>
              </div>
            </div>
            <div class="table-wrap">
              <table>
                <thead><tr><th>Roll No</th><th>Name</th><th>Action</th></tr></thead>
                <tbody>
                  <% data.hallTicketGeneratedList.forEach(function(r){ %>
                    <tr>
                      <td class="num"><%= r.rollNo %></td><td><%= r.name %></td>
                      <td class="flex gap-8"><button class="btn btn-ghost btn-sm">Publish</button><button class="btn btn-ghost btn-sm">Download</button></td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>

        </div><!-- /generate-new -->

        <!-- ============================================================ HALL TICKET HISTORY PANEL -->
        <div class="tab-panel" data-tab-panel="history" data-tab-family="hallTicketTabs">
          
          <div class="card">
            <div class="card__head">
              <div class="card__title">Hall Ticket History Records</div>
            </div>
            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th>Sr No</th>
                    <th>Standard</th>
                    <th>Date</th>
                    <th>Exam Type</th>
                    <th>Action</th>
                  </tr>
                </thead>
                <tbody>
                  <% data.hallTicketHistory.forEach(function(h){ %>
                    <tr>
                      <td class="num"><%= h.srNo %></td>
                      <td class="num">Std <%= h.standard %></td>
                      <td class="num"><%= h.date %></td>
                      <td><span class="chip chip-neutral"><%= h.type %></span></td>
                      <td>
                        <button class="btn btn-ghost btn-sm" onclick="alert('Viewing hall ticket batch...')">View All</button>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>

        </div><!-- /history -->

      </div>
    </div>
  </div>

  <%- include('../partials/scripts') %>
</body>
</html>

