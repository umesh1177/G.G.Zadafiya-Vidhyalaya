<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head', { title: 'Result Generation' }) %>
</head>
<body>
  <div class="app">
    <%- include('../partials/sidebar', { active: 'result', data: data }) %>

    <div class="main">
      <%- include('../partials/topbar', { title: 'Result Generation', subtitle: 'Weekly, Monthly and Annual result sheets', data: data }) %>

      <div class="content">

        <div class="kpi-grid">
          <div class="kpi-card"><div class="kpi-card__label">Total Result</div><div class="kpi-card__value num"><%= data.resultStats.total %></div></div>
          <div class="kpi-card"><div class="kpi-card__label">Weekly</div><div class="kpi-card__value num"><%= data.resultStats.weekly %></div></div>
          <div class="kpi-card"><div class="kpi-card__label">Monthly</div><div class="kpi-card__value num"><%= data.resultStats.monthly %></div></div>
          <div class="kpi-card"><div class="kpi-card__label">Annual</div><div class="kpi-card__value num"><%= data.resultStats.annual %></div></div>
        </div>

        <div class="tabs" data-tab-group="resultTabs">
          <button class="tab-btn is-active" data-tab-target="generate-result">Generate New Result</button>
          <button class="tab-btn" data-tab-target="result-history">Result History</button>
        </div>

        <!-- GENERATE NEW RESULT -->
        <div class="tab-panel is-active" data-tab-panel="generate-result" data-tab-family="resultTabs">
          <div class="card">
            <div class="card__title" style="margin-bottom:16px;">Result Setup</div>
            <div class="form-grid" style="margin-bottom:16px;">
              <div><label class="field-label">Standard</label><select class="filter-select w-full"><option>11</option><option>12</option></select></div>
              <div><label class="field-label">Type</label><select class="filter-select w-full"><option>Weekly</option><option>Monthly</option><option>Annual</option></select></div>
              <div><label class="field-label">Division</label><select class="filter-select w-full"><option>A</option><option>B</option></select></div>
              <div><label class="field-label">Upload Format</label><div class="upload-box">Click or drag a file here</div></div>
            </div>

            <label class="field-label">Add Subject</label>
            <div class="step-row">
              <select class="filter-select" data-field-for="resultSubjectList-subject" style="min-width: 180px;">
                <option value="">Select Subject</option>
                <option value="Physics">Physics</option>
                <option value="Chemistry">Chemistry</option>
                <option value="Maths">Maths</option>
                <option value="Biology">Biology</option>
                <option value="English">English</option>
                <option value="Computer">Computer</option>
              </select>
              <input type="date" class="field-input" data-field-for="resultSubjectList-date" style="max-width:180px;">
              <button type="button" class="btn btn-ghost btn-sm" data-add-chip="resultSubjectList">+ Add</button>
            </div>
            <div id="resultSubjectList" class="added-list">
              <div class="added-chip"><span>Physics — 19 May 2026</span><button type="button" aria-label="Remove">&times;</button></div>
              <div class="added-chip"><span>Chemistry — 20 May 2026</span><button type="button" aria-label="Remove">&times;</button></div>
            </div>

            <button class="btn btn-primary">Generate Result</button>
          </div>

          <div class="card">
            <div class="card__head">
              <div class="card__title">Generated Result List</div>
              <div class="flex gap-8">
                <button class="btn btn-ghost btn-sm">Publish All</button>
                <button class="btn btn-ghost btn-sm">Print All</button>
                <button class="btn btn-ghost btn-sm">Download All</button>
              </div>
            </div>
            <div class="table-wrap">
              <table>
                <thead><tr><th>Roll No</th><th>Name</th><th>Action</th></tr></thead>
                <tbody>
                  <% data.resultGeneratedList.forEach(function(r){ %>
                    <tr>
                      <td class="num"><%= r.rollNo %></td><td><%= r.name %></td>
                      <td class="flex gap-8"><button class="btn btn-ghost btn-sm">Publish</button><button class="btn btn-ghost btn-sm">Download</button></td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- RESULT HISTORY -->
        <div class="tab-panel" data-tab-panel="result-history" data-tab-family="resultTabs">
          <div class="card">
            <div class="card__head"><div class="card__title">Result History</div></div>
            <div class="filters">
              <select class="filter-select"><option>Type</option><option>Weekly</option><option>Monthly</option><option>Annual</option></select>
              <select class="filter-select"><option>Standard</option><option>11</option><option>12</option></select>
              <select class="filter-select"><option>Division</option><option>A</option><option>B</option></select>
            </div>
            <div class="table-wrap">
              <table>
                <thead><tr><th>Sr No</th><th>Standard</th><th>Division</th><th>Date</th><th>Type</th><th>Action</th></tr></thead>
                <tbody>
                  <% data.resultHistory.forEach(function(r){ %>
                    <tr>
                      <td class="num"><%= r.srNo %></td><td class="num"><%= r.standard %></td><td class="num"><%= r.division %></td>
                      <td class="num"><%= r.date %></td><td><span class="chip chip-neutral"><%= r.type %></span></td>
                      <td><button class="btn btn-ghost btn-sm">View All</button></td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>

  <%- include('../partials/scripts') %>
</body>
</html>

