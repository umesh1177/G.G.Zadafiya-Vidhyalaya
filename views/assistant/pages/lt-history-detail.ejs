<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head', { title: 'LT #' + ltId + ' — Detail' }) %>
</head>
<body>
  <div class="app">
    <%- include('../partials/sidebar', { active: 'lt', data: data }) %>

    <div class="main">
      <%- include('../partials/topbar', {
        title: 'LT #' + ltId + ' — Details',
        subtitle: 'Full details and student marks for this Lecture Test',
        data: data
      }) %>

      <div class="content">

        <div style="margin-bottom:20px;">
          <a href="/assistant/lt" class="btn btn-ghost btn-sm">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:14px;height:14px;"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
            Back to LT
          </a>
        </div>

        <%
          var d = data.lt.historyDetail[ltId];
          var students = (data.lt.historyStudentMarks && data.lt.historyStudentMarks[ltId])
                         ? data.lt.historyStudentMarks[ltId] : null;
        %>

        <% if (d) { %>

          <div class="card" style="margin-bottom:22px;">
            <div class="card__title" style="margin-bottom:14px;">LT Details</div>
            <div class="detail-panel">
              <div class="detail-panel__row"><span>Subject</span><span><%= d.subject %></span></div>
              <div class="detail-panel__row"><span>Date</span><span class="num"><%= d.date %></span></div>
              <div class="detail-panel__row"><span>Type</span><span><%= d.type %></span></div>
              <div class="detail-panel__row"><span>Time</span><span><%= d.time %></span></div>
              <div class="detail-panel__row"><span>Topic</span><span><%= d.topic %></span></div>
            </div>
          </div>

          <div class="card">
            <div class="card__head">
              <div>
                <div class="card__title">Student Marks</div>
                <div class="card__desc">Marks recorded for LT #<%= ltId %> — <%= d.subject %></div>
              </div>
            </div>
            <div class="table-wrap">
              <table>
                <thead>
                  <tr><th>Roll No</th><th>Name</th><th>Mark</th><th>Action</th></tr>
                </thead>
                <tbody>
                  <% if (students && students.length > 0) { %>
                    <% students.forEach(function(s){ %>
                      <tr>
                        <td class="num"><%= s.rollNo %></td>
                        <td><%= s.name %></td>
                        <td>
                          <% if (s.mark === 'Excellent') { %>
                            <span class="chip chip-success">Excellent</span>
                          <% } else if (s.mark === 'Better') { %>
                            <span class="chip chip-neutral">Better</span>
                          <% } else if (s.mark === 'Good') { %>
                            <span class="chip chip-warning">Good</span>
                          <% } else { %>
                            <span class="chip chip-danger">AB</span>
                          <% } %>
                        </td>
                        <td>
                          <button class="btn btn-ghost btn-sm"
                            data-modal-open="editMark-<%= ltId %>-<%= s.rollNo %>">
                            Edit Mark
                          </button>
                        </td>
                      </tr>
                    <% }) %>
                  <% } else { %>
                    <tr>
                      <td colspan="4" style="text-align:center; color:var(--slate); padding:28px; font-size:13px;">
                        No marks recorded for this LT yet.
                      </td>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>

        <% } else { %>
          <div class="empty-state">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v4M12 16h.01"/></svg>
            <p>LT #<%= ltId %> not found.</p>
          </div>
        <% } %>

      </div>
    </div>
  </div>

  <!-- Edit Mark Modals -->
  <% if (d && students) { %>
    <% students.forEach(function(s){ %>
      <div class="modal-overlay" id="editMark-<%= ltId %>-<%= s.rollNo %>" data-modal>
        <div class="modal-box">
          <div class="modal-box__head">
            <div>
              <div class="card__title">Edit Mark</div>
              <div class="card__desc"><%= s.name %> &nbsp;·&nbsp; Roll No <span class="num"><%= s.rollNo %></span></div>
            </div>
            <button class="modal-close" data-modal-close>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 6l12 12M18 6 6 18"/></svg>
            </button>
          </div>
          <div style="margin-bottom:18px;">
            <label class="field-label">Select New Mark</label>
            <div class="score-pill-group">
              <button type="button" class="score-pill <%= s.mark === 'Excellent' ? 'is-selected' : '' %>" data-score="Excellent">Excellent</button>
              <button type="button" class="score-pill <%= s.mark === 'Better'    ? 'is-selected' : '' %>" data-score="Better">Better</button>
              <button type="button" class="score-pill <%= s.mark === 'Good'      ? 'is-selected' : '' %>" data-score="Good">Good</button>
              <button type="button" class="score-pill <%= s.mark === 'AB'        ? 'is-selected' : '' %>" data-score="AB">AB</button>
            </div>
          </div>
          <button class="btn btn-primary btn-block" data-modal-close>Save Changes</button>
        </div>
      </div>
    <% }) %>
  <% } %>

  <%- include('../partials/scripts') %>
</body>
</html>

