<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head', { title: 'Enter Marks — Exam #' + examId }) %>
  <style>
    .exam-group-tabs {
      display: flex;
      gap: 8px;
      margin-bottom: 20px;
      background: var(--surface-muted);
      padding: 6px;
      border-radius: var(--radius-md);
      max-width: fit-content;
    }
    .exam-group-btn {
      padding: 8px 24px;
      border-radius: var(--radius-sm);
      font-size: 13px;
      font-weight: 700;
      cursor: pointer;
      border: none;
      background: transparent;
      color: var(--slate);
      transition: all 0.2s ease;
    }
    .exam-group-btn.is-active {
      background: var(--surface);
      color: var(--indigo);
      box-shadow: var(--shadow-sm);
    }
    .mark-input {
      width: 80px;
      text-align: center;
      padding: 6px 8px;
      border: 1.5px solid #8e9bb0; /* Clearly visible, dark border as requested */
      border-radius: var(--radius-sm);
      font-family: var(--font-mono);
      font-size: 13px;
      background: #fff;
      color: var(--ink);
      transition: border-color 0.15s ease, background-color 0.15s ease;
    }
    .mark-input:focus {
      border-color: var(--indigo);
      outline: none;
    }
    .mark-input:disabled {
      background: #f1f5f9;
      color: #94a3b8;
      border-color: #cbd5e1;
      cursor: not-allowed;
    }
    /* AB Button Styles */
    .btn-ab {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 6px 12px;
      font-size: 11px;
      font-weight: 700;
      font-family: var(--font-display);
      border-radius: var(--radius-sm);
      border: 1.5px solid #8e9bb0;
      background: #fff;
      color: var(--ink-soft);
      cursor: pointer;
      transition: all 0.2s ease;
      user-select: none;
    }
    .btn-ab:hover {
      background: #f8fafc;
      border-color: var(--ink-soft);
    }
    .btn-ab.is-active {
      background: var(--danger) !important;
      color: #fff !important;
      border-color: var(--danger) !important;
      box-shadow: 0 0 10px rgba(239, 68, 68, 0.2);
    }
    /* Group container to hold total and AB button together */
    .input-ab-group {
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }
  </style>
</head>
<body>
  <div class="app">
    <%- include('../partials/sidebar', { active: 'exam', data: data }) %>

    <div class="main">
      <%
        var ex = data.examCompleted.find(e => e.examNo === examId);
        var subjectDisplay = ex ? ex.subject : 'Chemistry';
        var typeDisplay = ex ? ex.type : 'Board';
        var standardDisplay = ex ? ex.standard : '11-A';

        // Format subject display according to rules:
        if (ex) {
          if (ex.type === 'JEE') subjectDisplay = 'PCM';
          else if (ex.type === 'NEET') subjectDisplay = 'PCB';
          else if (ex.type === 'GUJCET') subjectDisplay = 'PCMB';
        }
      %>

      <%- include('../partials/topbar', {
        title: 'Enter Marks — Exam #' + examId,
        subtitle: 'Record marks for ' + typeDisplay + ' Exam (' + subjectDisplay + ', Std ' + standardDisplay + ')',
        data: data
      }) %>

      <div class="content">
        <div style="margin-bottom:20px;">
          <button onclick="window.close();" class="btn btn-ghost btn-sm">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:14px;height:14px;margin-right:6px;"><path d="M18 6L6 18M6 6l12 12"/></svg>
            Close Tab
          </button>
        </div>

        <% if (ex) { %>
          <% if (ex.type === 'GUJCET') { %>
            <!-- GUJCET Group Selector -->
            <div class="exam-group-tabs">
              <button class="exam-group-btn is-active" id="btnGroupA">Group A (Maths)</button>
              <button class="exam-group-btn" id="btnGroupB">Group B (Biology)</button>
            </div>

            <!-- Group A Card -->
            <div class="card" id="cardGroupA">
              <div class="card__title" style="margin-bottom:14px;">Group A Student Marks List</div>
              <div class="table-wrap">
                <table>
                  <thead>
                    <tr>
                      <th>Roll No</th>
                      <th>Name</th>
                      <th>Physics</th>
                      <th>Chemistry</th>
                      <th>Maths</th>
                      <th>Total & AB Status</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% data.examMarksStudents.forEach(function(s, index){ %>
                      <tr class="student-row" data-row-id="A-<%= index %>">
                        <td class="num"><%= s.rollNo %></td>
                        <td><%= s.name %></td>
                        <td><input type="number" class="mark-input p-input" min="0" max="100" placeholder="0-100"></td>
                        <td><input type="number" class="mark-input c-input" min="0" max="100" placeholder="0-100"></td>
                        <td><input type="number" class="mark-input m-input" min="0" max="100" placeholder="0-100"></td>
                        <td>
                          <div class="input-ab-group">
                            <input type="number" class="mark-input total-input" readonly placeholder="0">
                            <button type="button" class="btn-ab" data-btn-ab>AB</button>
                            <input type="checkbox" style="display:none;" class="ab-checkbox">
                          </div>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
              <button class="btn btn-primary" style="margin-top:20px;" onclick="alert('Group A marks submitted successfully!'); window.close();">Submit Group A Marks</button>
            </div>

            <!-- Group B Card -->
            <div class="card" id="cardGroupB" style="display:none;">
              <div class="card__title" style="margin-bottom:14px;">Group B Student Marks List</div>
              <div class="table-wrap">
                <table>
                  <thead>
                    <tr>
                      <th>Roll No</th>
                      <th>Name</th>
                      <th>Physics</th>
                      <th>Chemistry</th>
                      <th>Biology</th>
                      <th>Total & AB Status</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% data.examMarksStudents.forEach(function(s, index){ %>
                      <tr class="student-row" data-row-id="B-<%= index %>">
                        <td class="num"><%= s.rollNo %></td>
                        <td><%= s.name %></td>
                        <td><input type="number" class="mark-input p-input" min="0" max="100" placeholder="0-100"></td>
                        <td><input type="number" class="mark-input c-input" min="0" max="100" placeholder="0-100"></td>
                        <td><input type="number" class="mark-input b-input" min="0" max="100" placeholder="0-100"></td>
                        <td>
                          <div class="input-ab-group">
                            <input type="number" class="mark-input total-input" readonly placeholder="0">
                            <button type="button" class="btn-ab" data-btn-ab>AB</button>
                            <input type="checkbox" style="display:none;" class="ab-checkbox">
                          </div>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
              <button class="btn btn-primary" style="margin-top:20px;" onclick="alert('Group B marks submitted successfully!'); window.close();">Submit Group B Marks</button>
            </div>

          <% } else if (ex.type === 'JEE' || ex.type === 'NEET') { %>
            <div class="card">
              <div class="card__title" style="margin-bottom:14px;">Student Marks List</div>
              <div class="table-wrap">
                <table>
                  <thead>
                    <tr>
                      <th>Roll No</th>
                      <th>Name</th>
                      <th>Physics</th>
                      <th>Chemistry</th>
                      <th><%= ex.type === 'JEE' ? 'Maths' : 'Biology' %></th>
                      <th>Total & AB Status</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% data.examMarksStudents.forEach(function(s, index){ %>
                      <tr class="student-row" data-row-id="comp-<%= index %>">
                        <td class="num"><%= s.rollNo %></td>
                        <td><%= s.name %></td>
                        <td><input type="number" class="mark-input p-input" min="0" max="100" placeholder="0-100"></td>
                        <td><input type="number" class="mark-input c-input" min="0" max="100" placeholder="0-100"></td>
                        <td><input type="number" class="mark-input <%= ex.type === 'JEE' ? 'm-input' : 'b-input' %>" min="0" max="100" placeholder="0-100"></td>
                        <td>
                          <div class="input-ab-group">
                            <input type="number" class="mark-input total-input" readonly placeholder="0">
                            <button type="button" class="btn-ab" data-btn-ab>AB</button>
                            <input type="checkbox" style="display:none;" class="ab-checkbox">
                          </div>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
              <button class="btn btn-primary" style="margin-top:20px;" onclick="alert('Exam marks submitted successfully!'); window.close();">Submit Marks</button>
            </div>

          <% } else { %>
            <!-- Board or standard single-subject Exam -->
            <div class="card">
              <div class="card__title" style="margin-bottom:14px;">Student Marks List</div>
              <div class="table-wrap">
                <table>
                  <thead>
                    <tr>
                      <th>Roll No</th>
                      <th>Name</th>
                      <th>Marks & AB Status</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% data.examMarksStudents.forEach(function(s, index){ %>
                      <tr class="student-row" data-row-id="board-<%= index %>">
                        <td class="num"><%= s.rollNo %></td>
                        <td><%= s.name %></td>
                        <td>
                          <div class="input-ab-group">
                            <input type="number" class="mark-input single-mark-input" min="0" max="100" placeholder="0-100">
                            <button type="button" class="btn-ab" data-btn-ab>AB</button>
                            <input type="checkbox" style="display:none;" class="ab-checkbox">
                          </div>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
              <button class="btn btn-primary" style="margin-top:20px;" onclick="alert('Exam marks submitted successfully!'); window.close();">Submit Marks</button>
            </div>
          <% } %>
        <% } else { %>
          <div class="empty-state">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v4M12 16h.01"/></svg>
            <p>Exam #<%= examId %> not found.</p>
          </div>
        <% } %>

      </div>
    </div>
  </div>

  <%- include('../partials/scripts') %>
  <script>
    // Tab switching for GUJCET (Group A / Group B)
    var btnA = document.getElementById('btnGroupA');
    var btnB = document.getElementById('btnGroupB');
    var cardA = document.getElementById('cardGroupA');
    var cardB = document.getElementById('cardGroupB');

    if (btnA && btnB) {
      btnA.addEventListener('click', function() {
        btnA.classList.add('is-active');
        btnB.classList.remove('is-active');
        cardA.style.display = 'block';
        cardB.style.display = 'none';
      });
      btnB.addEventListener('click', function() {
        btnB.classList.add('is-active');
        btnA.classList.remove('is-active');
        cardB.style.display = 'block';
        cardA.style.display = 'none';
      });
    }

    // Auto-calculate Totals and handle AB button toggles
    document.querySelectorAll('.student-row').forEach(function(row) {
      var inputs = row.querySelectorAll('input[type="number"]:not(.total-input)');
      var totalInput = row.querySelector('.total-input');
      var abBtn = row.querySelector('[data-btn-ab]');
      var abCheck = row.querySelector('.ab-checkbox');

      function calculateTotal() {
        if (!totalInput) return;
        var sum = 0;
        var hasValue = false;
        inputs.forEach(function(inp) {
          var val = parseFloat(inp.value);
          if (!isNaN(val)) {
            sum += val;
            hasValue = true;
          }
        });
        totalInput.value = hasValue ? sum : '';
      }

      inputs.forEach(function(inp) {
        inp.addEventListener('input', calculateTotal);
      });

      if (abBtn && abCheck) {
        abBtn.addEventListener('click', function() {
          var isAb = !abCheck.checked;
          abCheck.checked = isAb;
          
          if (isAb) {
            abBtn.classList.add('is-active');
          } else {
            abBtn.classList.remove('is-active');
          }

          inputs.forEach(function(inp) {
            inp.disabled = isAb;
            if (isAb) inp.value = '';
          });

          if (totalInput) {
            totalInput.value = isAb ? '0' : '';
          }

          var singleInp = row.querySelector('.single-mark-input');
          if (singleInp) {
            singleInp.disabled = isAb;
            if (isAb) singleInp.value = '';
          }
        });
      }
    });
  </script>
</body>
</html>

