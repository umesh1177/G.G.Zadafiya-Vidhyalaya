<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head', { title: 'Enter Marks — LT #' + ltId }) %>
</head>
<body>
  <div class="app">
    <%- include('../partials/sidebar', { active: 'lt', data: data }) %>

    <div class="main">
      <%- include('../partials/topbar', {
        title: 'Enter Marks — LT #' + ltId,
        subtitle: 'Record student marks for pending Lecture Test',
        data: data
      }) %>

      <div class="content">

        <div style="margin-bottom:20px;">
          <button onclick="window.close();" class="btn btn-ghost btn-sm">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:14px;height:14px;margin-right:6px;"><path d="M18 6L6 18M6 6l12 12"/></svg>
            Close Tab
          </button>
        </div>

        <div class="card">
          <div class="card__title" style="margin-bottom:14px;">
            Enter Marks — LT #<%= ltId %>
          </div>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Roll No</th>
                  <th>Name</th>
                  <th>Marks</th>
                </tr>
              </thead>
              <tbody>
                <% data.lt.pendingStudents.forEach(function(s){ %>
                  <tr>
                    <td class="num"><%= s.rollNo %></td>
                    <td><%= s.name %></td>
                    <td>
                      <div class="score-pill-group">
                        <button type="button" class="score-pill" data-score="Excellent">Excellent</button>
                        <button type="button" class="score-pill" data-score="Better">Better</button>
                        <button type="button" class="score-pill" data-score="Good">Good</button>
                        <button type="button" class="score-pill" data-score="AB">AB</button>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
          <button class="btn btn-primary" style="margin-top:20px;" onclick="alert('Marks submitted successfully!'); window.close();">Submit LT</button>
        </div>

      </div>
    </div>
  </div>

  <%- include('../partials/scripts') %>
  <script>
    // Add interactive click behavior to score pills
    document.querySelectorAll('.score-pill').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var group = btn.closest('.score-pill-group');
        group.querySelectorAll('.score-pill').forEach(function(b) {
          b.classList.remove('is-selected');
        });
        btn.classList.add('is-selected');
      });
    });
  </script>
</body>
</html>

