<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head', { title: 'Exam' }) %>
</head>
<body>
  <div class="app">
    <%- include('../partials/sidebar', { active: 'exam', data: data }) %>

    <div class="main">
      <%- include('../partials/topbar', {
        title: 'Exam',
        subtitle: 'Upcoming schedule, pending marks entries, and completed exam records',
        data: data
      }) %>

      <div class="content">

        <!-- KPI Grid -->
        <div class="kpi-grid">
          <div class="kpi-card">
            <div class="kpi-card__label">Total Exams</div>
            <div class="kpi-card__value num"><%= data.examStats.total %></div>
          </div>
          <div class="kpi-card is-warning">
            <div class="kpi-card__label">Pending Marks</div>
            <div class="kpi-card__value num"><%= data.examStats.pending %></div>
          </div>
          <div class="kpi-card">
            <div class="kpi-card__label">Upcoming</div>
            <div class="kpi-card__value num"><%= data.examStats.upcoming %></div>
          </div>
          <div class="kpi-card is-success">
            <div class="kpi-card__label">Completed</div>
            <div class="kpi-card__value num"><%= data.examStats.completed %></div>
          </div>
        </div>

        <% if (data.examStats.pending > 0) { %>
          <div class="banner banner-warning">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 9v4M12 16.5h.01"/>
              <path d="M10.3 3.9 2.7 17.5a1.6 1.6 0 0 0 1.4 2.4h16a1.6 1.6 0 0 0 1.4-2.4L13.7 3.9a1.6 1.6 0 0 0-2.8 0Z"/>
            </svg>
            <span>You have completed exams that require student marks entry. Check the <strong>Pending Exam</strong> tab.</span>
          </div>
        <% } %>

        <div class="tabs" data-tab-group="examTabs">
          <button class="tab-btn is-active" data-tab-target="upcoming-exam">Upcoming Exam</button>
          <button class="tab-btn" data-tab-target="pending-exam">
            Pending Exam (<%= data.examCompleted.filter(e => e.status === 'awaiting').length %>)
          </button>
          <button class="tab-btn" data-tab-target="completed-exam">Completed Exam</button>
        </div>

        <!-- ============================================================ UPCOMING EXAMS -->
        <div class="tab-panel is-active" data-tab-panel="upcoming-exam" data-tab-family="examTabs">
          <div class="card">
            <div class="card__title" style="margin-bottom:14px;">Upcoming Exam Schedule</div>
            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th>Sr. No</th>
                    <th>Date</th>
                    <th>Subject</th>
                    <th>Unit</th>
                    <th>Type</th>
                  </tr>
                </thead>
                <tbody>
                  <% data.examUpcoming.forEach(function(e){ %>
                    <%
                      var sub = e.subject;
                      if (e.type === 'JEE') sub = 'PCM';
                      else if (e.type === 'NEET') sub = 'PCB';
                      else if (e.type === 'GUJCET') sub = 'PCMB';
                    %>
                    <tr>
                      <td class="num"><%= e.srNo %></td>
                      <td class="num"><%= e.date %></td>
                      <td><strong><%= sub %></strong></td>
                      <td><%= e.unit %></td>
                      <td><span class="chip chip-neutral"><%= e.type %></span></td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- ============================================================ PENDING EXAMS -->
        <div class="tab-panel" data-tab-panel="pending-exam" data-tab-family="examTabs">
          <div class="card">
            <div class="card__title" style="margin-bottom:14px;">Pending Exam Marks Entry</div>
            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th>Exam No</th>
                    <th>Date</th>
                    <th>Standard</th>
                    <th>Type</th>
                    <th>Subject</th>
                    <th>Status</th>
                    <th>Action</th>
                  </tr>
                </thead>
                <tbody>
                  <%
                    var pendingExams = data.examCompleted.filter(e => e.status === 'awaiting');
                  %>
                  <% if (pendingExams.length > 0) { %>
                    <% pendingExams.forEach(function(e){ %>
                      <%
                        var sub = e.subject;
                        if (e.type === 'JEE') sub = 'PCM';
                        else if (e.type === 'NEET') sub = 'PCB';
                        else if (e.type === 'GUJCET') sub = 'PCMB';
                      %>
                      <tr>
                        <td class="num"><%= e.examNo %></td>
                        <td class="num"><%= e.date %></td>
                        <td class="num"><%= e.standard %></td>
                        <td><span class="chip chip-neutral"><%= e.type %></span></td>
                        <td><strong><%= sub %></strong></td>
                        <td><span class="chip chip-warning">Awaiting Marks</span></td>
                        <td>
                          <a href="/assistant/exam/enter-marks/<%= e.examNo %>" target="_blank" class="btn btn-primary btn-sm">
                            Enter Marks
                          </a>
                        </td>
                      </tr>
                    <% }) %>
                  <% } else { %>
                    <tr>
                      <td colspan="7" style="text-align:center; color:var(--slate); padding:28px;">
                        No pending exams awaiting marks entry.
                      </td>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- ============================================================ COMPLETED EXAMS -->
        <div class="tab-panel" data-tab-panel="completed-exam" data-tab-family="examTabs">
          <div class="card">
            <div class="card__title" style="margin-bottom:14px;">Completed Exam Records</div>
            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th>Exam No</th>
                    <th>Date</th>
                    <th>Standard</th>
                    <th>Type</th>
                    <th>Subject</th>
                    <th>Action</th>
                  </tr>
                </thead>
                <tbody>
                  <%
                    var completedExams = data.examCompleted.filter(e => e.status === 'entered');
                  %>
                  <% if (completedExams.length > 0) { %>
                    <% completedExams.forEach(function(e){ %>
                      <%
                        var sub = e.subject;
                        if (e.type === 'JEE') sub = 'PCM';
                        else if (e.type === 'NEET') sub = 'PCB';
                        else if (e.type === 'GUJCET') sub = 'PCMB';
                      %>
                      <tr>
                        <td class="num"><%= e.examNo %></td>
                        <td class="num"><%= e.date %></td>
                        <td class="num"><%= e.standard %></td>
                        <td><span class="chip chip-neutral"><%= e.type %></span></td>
                        <td><strong><%= sub %></strong></td>
                        <td>
                          <div style="display:flex; gap:8px;">
                            <a href="/assistant/exam/view-marks/<%= e.examNo %>" target="_blank" class="btn btn-ghost btn-sm">
                              View Marks
                            </a>
                            <button class="btn btn-sm" style="background: var(--success); color: #fff; border: 1px solid var(--success); font-weight: 700;" onclick="alert('Downloading Excel report...')">
                              Download Excel
                            </button>
                          </div>
                        </td>
                      </tr>
                    <% }) %>
                  <% } else { %>
                    <tr>
                      <td colspan="6" style="text-align:center; color:var(--slate); padding:28px;">
                        No completed exams found with entered marks.
                      </td>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </div>

      </div><!-- /content -->
    </div><!-- /main -->
  </div><!-- /app -->

  <%- include('../partials/scripts') %>
</body>
</html>

