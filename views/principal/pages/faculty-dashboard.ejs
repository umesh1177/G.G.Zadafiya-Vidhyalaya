<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Faculty Dashboard</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
        href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;600&family=Manrope:wght@400;600;700;800&family=Space+Grotesk:wght@400;600;700&display=swap"
        rel="stylesheet" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
    <link rel="stylesheet" href="/principal/css/faculty.css" />
</head>

<body>
    <div class="app">
        <div class="sidebar-overlay" id="sidebarOverlay"></div>

        <aside class="sidebar" id="sidebar">
            <div class="sidebar__brand">
                <div class="sidebar__logo">
                    <%= (data && data.school && data.school.logoInitials) ? data.school.logoInitials : 'SV' %>
                </div>
                <div>
                    <div class="sidebar__school">
                        <%= (data && data.school && data.school.name) ? data.school.name : 'Vatsalya Vidhyabhavan' %>
                    </div>
                    <div class="sidebar__role">
                        <%= (data && data.faculty && data.faculty.role) ? data.faculty.role : 'Assistant Faculty' %>
                    </div>
                </div>
            </div>

            <div class="sidebar__profile">
                <div class="sidebar__avatar">
                    <%= (data && data.faculty && data.faculty.initials) ? data.faculty.initials : 'AF' %>
                </div>
                <div>
                    <div class="sidebar__name">
                        <%= (data && data.faculty && data.faculty.name) ? data.faculty.name : 'Faculty Member' %>
                    </div>
                    <div class="sidebar__dept">
                        <%= (data && data.faculty && data.faculty.department) ? data.faculty.department
                            : 'Science Stream' %>
                    </div>
                </div>
            </div>

            <nav class="sidebar__nav">
                <button class="navlink is-active" data-page="home">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                        stroke-linejoin="round">
                        <path d="M3 11.5 12 4l9 7.5" />
                        <path d="M5 10v10h14V10" />
                        <path d="M9.5 20v-6h5v6" />
                    </svg>
                    Home
                </button>

                <div class="sidebar__group-label">Teaching</div>

                <button class="navlink" data-page="lt">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                        stroke-linejoin="round">
                        <path d="M7 3.5h7l3.5 3.5V20a.6.6 0 0 1-.6.6H7a.6.6 0 0 1-.6-.6V4.1A.6.6 0 0 1 7 3.5Z" />
                        <path d="M14 3.5V7h3.5" />
                        <path d="M9 12h6M9 15.3h6M9 8.7h3" />
                    </svg>
                    LT (Learning Topics)
                </button>

                <button class="navlink" data-page="syllabus">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                        stroke-linejoin="round">
                        <path d="M4 19V5M4 19h16" />
                        <path d="M9 10h6M9 13.5h4M9 17h2" />
                        <rect x="3.5" y="3.5" width="17" height="17" rx="2" />
                    </svg>
                    Syllabus Tracker
                </button>

                <button class="navlink" data-page="setlt">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                        stroke-linejoin="round">
                        <circle cx="12" cy="12" r="9" />
                        <path d="M12 8v4l2.5 2.5" />
                    </svg>
                    Set LT
                </button>

                <button class="navlink" data-page="examunit">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                        stroke-linejoin="round">
                        <path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2" />
                        <rect x="9" y="3" width="6" height="4" rx="1" />
                        <path d="M9 12h6M9 16h4" />
                    </svg>
                    Exam Unit Entry
                </button>

                <div class="sidebar__group-label">Administration</div>

                <button class="navlink" data-page="result">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                        stroke-linejoin="round">
                        <path d="M4 19V5M4 19h16" />
                        <path d="m6.5 15 3.5-4 3 2.4L18 8.5" />
                    </svg>
                    Result Generation
                </button>

                <button class="navlink" data-page="notice">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                        stroke-linejoin="round">
                        <path d="M9.5 18.5a2 2 0 0 0 3.7 0" />
                        <path
                            d="M5 17h13.5c-1.4-1.3-2.2-3-2.2-5.6V9.2A5.3 5.3 0 0 0 11 4a5.3 5.3 0 0 0-5.3 5.2v2.2C5.7 14 4.9 15.7 5 17Z" />
                    </svg>
                    Notice
                </button>

                <button class="navlink is-logout" data-page="logout">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                        stroke-linejoin="round">
                        <path d="M9 4.5H6.4A1.9 1.9 0 0 0 4.5 6.4v11.2a1.9 1.9 0 0 0 1.9 1.9H9" />
                        <path d="M15.5 16.5 20 12l-4.5-4.5M20 12H9" />
                    </svg>
                    Logout
                </button>
            </nav>

            <div class="sidebar__footer">Std 11–12 · Science Stream · GSEB</div>
        </aside>

        <div class="main">
            <div class="topbar">
                <div class="topbar__left">
                    <button class="topbar__menu-btn" id="menuBtn">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                            stroke-linecap="round" stroke-linejoin="round">
                            <line x1="3" y1="6" x2="21" y2="6" />
                            <line x1="3" y1="12" x2="21" y2="12" />
                            <line x1="3" y1="18" x2="21" y2="18" />
                        </svg>
                    </button>
                    <div>
                        <div class="topbar__title" id="topbarTitle">Good Morning, <%= (data && data.faculty) ?
                                data.faculty.name : 'Faculty' %>
                        </div>
                        <div class="topbar__subtitle" id="topbarSub">Here's your teaching overview for today</div>
                    </div>
                </div>
                <div class="topbar__right">
                    <span class="topbar__date num" id="topbarDate"></span>
                    <div class="topbar__avatar">
                        <%= (data && data.faculty) ? data.faculty.initials : 'AF' %>
                    </div>
                </div>
            </div>

            <div class="content">
                <div class="page-section is-active" id="page-home">
                    <div class="kpi-grid">
                        <div class="kpi-card">
                            <div class="kpi-card__label">Today's LTs</div>
                            <div class="kpi-card__value num">
                                <%= (data && data.studentStats) ? data.studentStats.todaysLTsCount : 0 %>
                            </div>
                            <div class="kpi-card__hint">
                                <%= (data && data.studentStats) ? data.studentStats.subjectsList : '' %>
                            </div>
                        </div>
                        <div class="kpi-card is-warning">
                            <div class="kpi-card__label">Pending LTs</div>
                            <div class="kpi-card__value num">
                                <%= (data && data.studentStats) ? data.studentStats.pendingLTsCount : 0 %>
                            </div>
                            <div class="kpi-card__hint">Requires complete entries</div>
                        </div>
                        <div class="kpi-card is-success">
                            <div class="kpi-card__label">Attendance Marked</div>
                            <div class="kpi-card__value num">
                                <%= (data && data.studentStats) ? data.studentStats.attendanceRatio : '0/0' %>
                            </div>
                            <div class="kpi-card__hint">Active daily sessions</div>
                        </div>
                        <div class="kpi-card is-danger">
                            <div class="kpi-card__label">Upcoming Review Tasks</div>
                            <div class="kpi-card__value num">
                                <%= (data && data.studentStats) ? data.studentStats.pendingExamsCount : 0 %>
                            </div>
                            <div class="kpi-card__hint">Planned academic checks</div>
                        </div>
                    </div>

                    <div class="grid-2">
                        <div class="card">
                            <div class="card__head">
                                <div>
                                    <div class="card__title">Pending Action Items Queue</div>
                                    <div class="card__desc">Immediate logistical actions requiring your attention</div>
                                </div>
                            </div>
                            <div class="table-wrap">
                                <table>
                                    <thead>
                                        <tr>
                                            <th>Log Subject Item</th>
                                            <th>Standard Allocation</th>
                                            <th>Log Target Component</th>
                                            <th>Action Link</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% if (data && data.pendingActions && data.pendingActions.length> 0) { %>
                                            <% data.pendingActions.forEach(function(item) { %>
                                                <tr>
                                                    <td class="font-700">
                                                        <%= item.subject %>
                                                    </td>
                                                    <td class="num">
                                                        <%= item.standard %>
                                                    </td>
                                                    <td><span
                                                            class="chip <%= item.type === 'Attendance' ? 'chip-warning' : 'chip-danger' %>">
                                                            <%= item.type %>
                                                        </span></td>
                                                    <td><button class="btn btn-primary btn-xs"
                                                            onclick="routeToPage('<%= item.route %>')">Open
                                                            Dashboard</button></td>
                                                </tr>
                                                <% }) %>
                                                    <% } else { %>
                                                        <tr>
                                                            <td colspan="4" class="text-slate"
                                                                style="text-align: center; padding: 20px;">No pending
                                                                actions for today.</td>
                                                        </tr>
                                                        <% } %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div class="card">
                            <div class="card__head">
                                <div>
                                    <div class="card__title">Administrative Routing Links</div>
                                    <div class="card__desc">Quick jumps into sub-system modules</div>
                                </div>
                            </div>
                            <div class="grid-list-2 mt-4">
                                <button class="btn btn-ghost btn-block" style="height:54px;"
                                    onclick="routeToPage('lt')">Learning Topics Portal</button>
                                <button class="btn btn-ghost btn-block" style="height:54px;"
                                    onclick="routeToPage('syllabus')">Syllabus Tracker</button>
                                <button class="btn btn-ghost btn-block" style="height:54px;"
                                    onclick="routeToPage('setlt')">Set LT Panel</button>
                                <button class="btn btn-ghost btn-block" style="height:54px;"
                                    onclick="routeToPage('notice')">Dispatch Bulletins</button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="page-section" id="page-lt">
                    <div class="card">
                        <div class="card__head">
                            <div>
                                <h2 class="section-title">Learning Topics (LT) Controller Matrix</h2>
                                <p class="section-sub">Select an assigned running lecture block to log live dynamic
                                    counters</p>
                            </div>
                        </div>

                        <div class="filters filter-matrix mt-4">
                            <div class="filter-group">
                                <label class="field-label">Standard Filter</label>
                                <select class="filter-select" id="ltFilterStd" onchange="applyLTFilters()">
                                    <option value="all">All Active Standards</option>
                                    <option value="11">Standard 11</option>
                                    <option value="12">Standard 12</option>
                                </select>
                            </div>
                            <div class="filter-group">
                                <label class="field-label">Subject Track</label>
                                <select class="filter-select" id="ltFilterSub" onchange="applyLTFilters()">
                                    <option value="all">All Subjects</option>
                                    <option value="Physics">Physics</option>
                                    <option value="Chemistry">Chemistry</option>
                                </select>
                            </div>
                        </div>

                        <div class="grid-2 mt-4">
                            <div>
                                <div style="display:flex; flex-direction:column; gap:10px;" id="ltContainerList">
                                    <% if (data && data.learningTopics && data.learningTopics.length> 0) { %>
                                        <% data.learningTopics.forEach(function(lt, i) { %>
                                            <div class="lt-box <%= i === 0 ? 'selected' : '' %>"
                                                data-std="<%= lt.standard %>" data-sub="<%= lt.subject %>"
                                                onclick="selectLTBlock(this, '<%= lt.subject %>', '<%= lt.standard %>', '<%= lt.topic %>', '<%= lt.duration || '45' %>')">
                                                <div
                                                    style="display:flex; justify-content:space-between; align-items:center;">
                                                    <span class="lt-box__subject">
                                                        <%= lt.subject %> · <span class="num">Std <%= lt.standard %>
                                                            </span>
                                                    </span>
                                                    <span class="chip chip-neutral dynamic-duration-label">
                                                        <%= lt.duration || '45' %>m
                                                    </span>
                                                </div>
                                                <div class="lt-box__meta">Assigned Topic: <strong>
                                                        <%= lt.topic %>
                                                    </strong></div>
                                            </div>
                                            <% }) %>
                                                <% } else { %>
                                                    <div class="lt-box selected" data-std="12-A" data-sub="Physics"
                                                        onclick="selectLTBlock(this, 'Physics', '12-A', 'Electromagnetic Induction', '45')">
                                                        <div
                                                            style="display:flex; justify-content:space-between; align-items:center;">
                                                            <span class="lt-box__subject">Physics · <span
                                                                    class="num">Std 12-A</span></span>
                                                            <span
                                                                class="chip chip-neutral dynamic-duration-label">45m</span>
                                                        </div>
                                                        <div class="lt-box__meta">Assigned Topic:
                                                            <strong>Electromagnetic Induction</strong>
                                                        </div>
                                                    </div>
                                                    <div class="lt-box" data-std="11-B" data-sub="Chemistry"
                                                        onclick="selectLTBlock(this, 'Chemistry', '11-B', 'Organic Compounds structures', '45')">
                                                        <div
                                                            style="display:flex; justify-content:space-between; align-items:center;">
                                                            <span class="lt-box__subject">Chemistry · <span
                                                                    class="num">Std 11-B</span></span>
                                                            <span
                                                                class="chip chip-neutral dynamic-duration-label">45m</span>
                                                        </div>
                                                        <div class="lt-box__meta">Assigned Topic: <strong>Organic
                                                                Compounds structures</strong></div>
                                                    </div>
                                                    <% } %>
                                </div>
                            </div>
                            <div>
                                <div class="card card-muted" style="border-style: dashed; border-width: 2px;">
                                    <div class="card__title" id="activeLTHeading">Physics · Std 12-A</div>
                                    <p class="text-slate mb-4" id="activeLTSubheading">Current topic track:
                                        Electromagnetic Induction</p>

                                    <div class="timer-config-panel">
                                        <label class="field-label">Configure Timer Duration (Minutes)</label>
                                        <div class="timer-input-group mt-2">
                                            <input type="number" id="customTimerMinutes" class="filter-select num"
                                                min="1" max="180" value="45" style="width:100%;" placeholder="e.g. 45">
                                            <button class="btn btn-ghost num btn-xs" onclick="updateLTTrackTimer()">Set
                                                Timer</button>
                                        </div>
                                    </div>

                                    <div style="text-align: center; padding: 20px 0;">
                                        <div style="font-size: 36px; font-weight: 800; font-family: var(--font-mono); color: var(--indigo);"
                                            id="ltTimer">45:00</div>
                                        <div class="text-slate" style="font-size:11px; margin-top:4px;">ESTIMATED TRACK
                                            RUN TIME</div>
                                    </div>
                                    <div class="flex gap-12 justify-center">
                                        <button class="btn btn-primary" id="btnStartTracker"
                                            onclick="startFullscreenFocusMode()">Start Focus Tracker</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="page-section" id="page-result">
                    <div class="card">
                        <div class="card__head">
                            <div>
                                <div class="card__title">Result Generation Studio</div>
                                <div class="card__desc">Filter cohort parameters to compile and dispatch terminal
                                    analytics records</div>
                            </div>
                        </div>

                        <div class="filters exam-filter-grid mt-4">
                            <div class="filter-group">
                                <label class="field-label">Target Standard</label>
                                <select class="filter-select">
                                    <option>Standard 12</option>
                                    <option>Standard 11</option>
                                </select>
                            </div>
                            <div class="filter-group">
                                <label class="field-label">Stream Roster</label>
                                <select class="filter-select">
                                    <option>Science - Group A</option>
                                    <option>Science - Group B</option>
                                </select>
                            </div>
                            <div class="filter-group">
                                <label class="field-label">Exam Assessment</label>
                                <select class="filter-select">
                                    <option>Mid-Term Board Prelims</option>
                                    <option>Monthly Unit Test</option>
                                    <option>JEE Mock Series</option>
                                    <option>NEET Mock Series</option>
                                </select>
                            </div>
                            <div class="filter-group">
                                <label class="field-label">Output Format</label>
                                <select class="filter-select">
                                    <option>PDF Report Cards</option>
                                    <option>Excel / CSV Master Sheet</option>
                                </select>
                            </div>
                        </div>

                        <div class="grid-2 mt-4">
                            <div class="card card-muted"
                                style="text-align: center; padding: 40px 20px; border: 1px dashed var(--line); display:flex; flex-direction:column; justify-content:center;">
                                <svg viewBox="0 0 24 24" fill="none" stroke="var(--indigo)" stroke-width="1.5"
                                    style="width: 48px; height: 48px; margin: 0 auto 12px; display: block;">
                                    <path stroke-linecap="round" stroke-linejoin="round"
                                        d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
                                </svg>
                                <div class="text-slate mb-4"
                                    style="font-size:13.5px; max-width: 420px; margin: 0 auto 16px;">
                                    Initialize the automated parsing microservices script to compile cumulative class
                                    rank records based on your active filters.
                                </div>
                                <button class="btn btn-primary" style="margin: 0 auto;"
                                    onclick="triggerResultCompilation()">Generate Selected Format</button>
                            </div>
                            <div style="display:flex; flex-direction:column; gap:12px;">
                                <div class="card">
                                    <div class="card__title" style="font-size:14px;">Communication Dispatch</div>
                                    <div class="card__desc mb-4">Send compiled scorecards directly to registered parent
                                        contacts</div>
                                    <button class="btn btn-ghost w-full"
                                        onclick="alert('Email & SMS microservice initialized. Dispatching records...')">Broadcast
                                        Results via Email/SMS</button>
                                </div>
                                <div class="card">
                                    <div class="card__title" style="font-size:14px;">Cohort Analytics Preview</div>
                                    <div class="card__desc mb-4">Review batch performance averages before publishing
                                        official records</div>
                                    <button class="btn btn-ghost w-full"
                                        onclick="alert('Loading internal analytics metrics dashboard...')">View
                                        Analytics Dashboard</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="page-section" id="page-notice">
                    <div class="card">
                        <div class="card__head">
                            <div>
                                <div class="card__title">Dispatched System Bulletins Matrix</div>
                                <div class="card__desc">Review current system broadcasts deployed to active
                                    student-parent tracking groups</div>
                            </div>
                        </div>
                        <div style="display:flex; flex-direction:column; gap:12px;" class="mt-4">
                            <div class="lt-box"
                                onclick="openNoticeModal('All practical chemistry and physics laboratory manuals must be cross-verified and signed by the assigned supervisor before Friday at 4:00 PM.')">
                                <div style="display:flex; justify-content:space-between; align-items:center;">
                                    <div class="font-700" style="font-size:14px; color:var(--ink);">Academic Journal
                                        Verification Submissions Notice</div>
                                    <span class="text-slate num" style="font-size:11px;">TODAY</span>
                                </div>
                                <p class="text-slate" style="font-size:12px; margin-top:4px;">Target Audience: Std 12
                                    Science Stream Cohorts</p>
                            </div>
                            <div class="lt-box"
                                onclick="openNoticeModal('An emergency briefing covering quarterly assessment syllabus review will assemble at the main boardroom hall at 4:30 PM.')">
                                <div style="display:flex; justify-content:space-between; align-items:center;">
                                    <div class="font-700" style="font-size:14px; color:var(--ink);">Emergency Faculty
                                        Department Briefing Assembly</div>
                                    <span class="text-slate num" style="font-size:11px;">YESTERDAY</span>
                                </div>
                                <p class="text-slate" style="font-size:12px; margin-top:4px;">Target Audience: All
                                    Academic Stream Core Faculty Tiers</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ===================================================
                     PAGE: SYLLABUS TRACKER
                     =================================================== -->
                <div class="page-section" id="page-syllabus">
                    <!-- KPI Strip -->
                    <div class="kpi-grid" style="grid-template-columns: repeat(auto-fit,minmax(180px,1fr));">
                        <div class="kpi-card">
                            <div class="kpi-card__label">Total Chapters</div>
                            <div class="kpi-card__value num">18</div>
                            <div class="kpi-card__hint">Across all assigned subjects</div>
                        </div>
                        <div class="kpi-card is-success">
                            <div class="kpi-card__label">Completed Topics</div>
                            <div class="kpi-card__value num">34</div>
                            <div class="kpi-card__hint">Marked finished this term</div>
                        </div>
                        <div class="kpi-card is-warning">
                            <div class="kpi-card__label">Pending Topics</div>
                            <div class="kpi-card__value num">21</div>
                            <div class="kpi-card__hint">Yet to be covered</div>
                        </div>
                        <div class="kpi-card">
                            <div class="kpi-card__label">Overall Progress</div>
                            <div class="kpi-card__value num" id="syllabusOverallPct">62%</div>
                            <div class="progress-bar-wrap" style="margin-top:8px;">
                                <div class="progress-bar-fill is-success" id="syllabusOverallBar" style="width:62%;">
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="grid-2">
                        <!-- LEFT: Syllabus Chapter Accordion -->
                        <div class="card">
                            <div class="card__head">
                                <div>
                                    <div class="card__title">Syllabus Menu — Chapter & Topic Browser</div>
                                    <div class="card__desc">Expand chapters to view topics and mark them as finished
                                    </div>
                                </div>
                            </div>

                            <div class="filters filter-matrix mt-4" style="margin-bottom:14px;">
                                <div class="filter-group">
                                    <label class="field-label">Standard</label>
                                    <select class="filter-select" id="syllabusFilterStd" onchange="filterSyllabus()">
                                        <option value="all">All Standards</option>
                                        <option value="11">Standard 11</option>
                                        <option value="12">Standard 12</option>
                                    </select>
                                </div>
                                <div class="filter-group">
                                    <label class="field-label">Subject</label>
