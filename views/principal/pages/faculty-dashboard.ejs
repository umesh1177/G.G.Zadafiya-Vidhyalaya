                                            <div class="syllabus-topic-row">
                                                <span class="topic-name">3.1 Electric Current</span>
                                                <button class="btn btn-ghost btn-xs"
                                                    onclick="setExamUnitScope('Till Topic 3.1')">Till 3.1</button>
                                            </div>
                                            <div class="syllabus-topic-row">
                                                <span class="topic-name">3.2 Ohm's Law</span>
                                                <button class="btn btn-ghost btn-xs"
                                                    onclick="setExamUnitScope('Till Topic 3.2')">Till 3.2</button>
                                            </div>
                                            <div class="syllabus-topic-row">
                                                <span class="topic-name">3.3 Resistivity</span>
                                                <button class="btn btn-ghost btn-xs"
                                                    onclick="setExamUnitScope('Till Topic 3.3')">Till 3.3</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Exam Table Form -->
                            <div class="card" style="border-left: 4px solid var(--indigo);">
                                <div class="card__title">Exam Table — Schedule Entry</div>
                                <div class="card__desc mb-4">
                                    Scope selected: <strong id="examUnitScopeLabel" style="color:var(--indigo);">None
                                        selected</strong>
                                </div>
                                <input type="hidden" id="examUnitScopeInput" value="">
                                <div class="exam-unit-form-grid">
                                    <div class="filter-group">
                                        <label class="field-label">Exam Date</label>
                                        <input type="date" id="examUnitDate" class="filter-select">
                                    </div>
                                    <div class="filter-group">
                                        <label class="field-label">Type</label>
                                        <select class="filter-select" id="examUnitType">
                                            <option>Monthly</option>
                                            <option>Weekly</option>
                                            <option>Annual</option>
                                            <option>JEE Mock</option>
                                            <option>NEET Mock</option>
                                        </select>
                                    </div>
                                    <div class="filter-group">
                                        <label class="field-label">Subject</label>
                                        <select class="filter-select" id="examUnitSubject">
                                            <option>Physics</option>
                                            <option>Chemistry</option>
                                            <option>Mathematics</option>
                                            <option>Biology</option>
                                        </select>
                                    </div>
                                    <div class="filter-group">
                                        <label class="field-label">Standard</label>
                                        <select class="filter-select" id="examUnitStandard">
                                            <option>Std 12</option>
                                            <option>Std 11</option>
                                        </select>
                                    </div>
                                </div>
                                <button class="btn btn-primary mt-4" onclick="submitExamUnit()">Submit Exam
                                    Unit</button>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <div class="modal-overlay" id="noticeModal">
        <div class="modal-box">
            <div class="modal-box__head">
                <div class="card__title">System Notice Broadcast Detail</div>
                <button class="modal-close"
                    onclick="document.getElementById('noticeModal').classList.remove('is-open')">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                        stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18" />
                        <line x1="6" y1="6" x2="18" y2="18" />
                    </svg>
                </button>
            </div>
            <p id="noticeModalText"
                style="font-size:13.5px; padding: 12px 4px; line-height:1.6; color:var(--ink-soft);">Notice Content
                Vector Empty</p>
        </div>
    </div>

    <div class="modal-overlay" id="disciplineModal">
        <div class="modal-box">
            <div class="modal-box__head">
                <div class="card__title">Behavior Infraction Detail Matrix</div>
                <button class="modal-close"
                    onclick="document.getElementById('disciplineModal').classList.remove('is-open')">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                        stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18" />
                        <line x1="6" y1="6" x2="18" y2="18" />
                    </svg>
                </button>
            </div>
            <div class="detail-panel">
                <div class="detail-panel__row"><span>Target Student Candidate</span><span id="dmName">—</span></div>
                <div class="detail-panel__row"><span>Standard Section</span><span id="dmStd">—</span></div>
                <div class="detail-panel__row"><span>Infraction Item Class</span><span id="dmType"
                        style="color:var(--danger); font-weight:700;">—</span></div>
            </div>
            <div style="margin-top:14px;">
                <label class="field-label">Narrative Incident Context Report</label>
                <p style="font-size:13px; color:var(--ink-soft); background:var(--bg); padding:12px; border-radius:var(--radius-sm); margin-top:6px;"
                    id="dmNote">—</p>
            </div>
        </div>
    </div>

    <div class="fullscreen-timer-overlay" id="fsTimerOverlay">
        <button class="btn btn-ghost fs-exit-btn" onclick="exitFullscreenFocusMode()">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                stroke-linejoin="round" style="width:18px; height:18px;">
                <line x1="18" y1="6" x2="6" y2="18" />
                <line x1="6" y1="6" x2="18" y2="18" />
            </svg>
            Exit Focus Mode
        </button>
        <div class="fs-content">
            <div class="fs-subject" id="fsSubject">Physics · Std 12-A</div>
            <div class="fs-topic" id="fsTopic">Electromagnetic Induction</div>
            <div class="fs-time num" id="fsTimeDisplay">45:00</div>
            <div style="display:flex; gap:16px; justify-content:center; margin-top:40px;">
                <button class="btn btn-primary" style="font-size:18px; padding:16px 32px;" id="fsBtnToggle"
                    onclick="toggleTimerRunning()">Pause Tracker</button>
                <button class="btn btn-danger" style="font-size:18px; padding:16px 32px;"
                    onclick="completeLTLog()">Complete Log</button>
            </div>
        </div>
    </div>

    <script src="/principal/js/faculty.js"></script>
</body>

</html>
