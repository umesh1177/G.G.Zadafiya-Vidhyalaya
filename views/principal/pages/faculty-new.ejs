<!DOCTYPE html>
<html lang="en">

<head>
  <%- include('../partials/head', { title: 'Register New Faculty' }) %>
</head>

<body>
  <div class="app">
    <%- include('../partials/sidebar', { active: 'faculty' , data: data }) %>

    <div class="main">
      <%- include('../partials/topbar', { title: 'Faculty Registration' ,
        subtitle: 'Standalone faculty account creation interface' , data: data }) %>

        <div class="content">
          <a href="/principal/faculty-management" class="btn btn-ghost btn-sm" style="margin-bottom:18px;">&larr; Back to Faculty Management</a>

          <div class="card" style="max-width: 800px; margin: 0 auto;">
            <div class="card__head">
              <div>
                <div class="card__title">Create New Faculty Account</div>
                <div class="card__desc">Fill out the credentials and profile details to provision a school staff login.</div>
              </div>
            </div>
            <form class="form-grid" onsubmit="alert('Faculty account provisioned and registered in system catalog.'); window.location.href='/faculty-management'; return false;">
              <div><label class="field-label">Name</label><input class="field-input w-full" required
                  placeholder="e.g. Nisha Rao"></div>
              <div><label class="field-label">Email</label><input class="field-input w-full" type="email" required
                  placeholder="name@example.in"></div>
              <div><label class="field-label">Contact No.</label><input class="field-input w-full" required
                  placeholder="+91 XXXXX XXXXX"></div>
              <div><label class="field-label">Subject</label><input class="field-input w-full" required
                  placeholder="e.g. Chemistry"></div>
              <div><label class="field-label">Username</label><input class="field-input w-full" required
                  placeholder="Login username"></div>
              <div><label class="field-label">Password</label><input class="field-input w-full" type="password" required
                  placeholder="••••••••"></div>
              <div><label class="field-label">Joining Date</label><input class="field-input w-full" required
                  placeholder="DD-MM-YYYY"></div>
              <div><label class="field-label">Role</label>
                <select class="filter-select w-full">
                  <option>Subject Faculty</option>
                  <option>Assistant Faculty</option>
                </select>
              </div>
              <div class="span-2"><label class="field-label">Photo</label>
                <div class="upload-box">Click or drag a photo here</div>
              </div>
              <div class="span-2"><button class="btn btn-primary btn-block" type="submit">Create Faculty
                  Account</button></div>
            </form>
          </div>

        </div>
    </div>
  </div>

  <%- include('../partials/scripts') %>
</body>

</html>

