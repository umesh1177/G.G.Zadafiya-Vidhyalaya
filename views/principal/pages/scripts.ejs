<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.4/chart.umd.min.js"></script>
<script src="/principal/js/main.js">
    document.addEventListener('DOMContentLoaded', () => {

        // === 1. ANALYTICS CHART INITIALIZATION ===
        const chartCanvas = document.getElementById('streamAnalyticsChart');
        if (chartCanvas) {
            const ctx = chartCanvas.getContext('2d');
            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: ['Group A', 'Group B', 'Group AB'],
                    datasets: [{
                        label: 'Student Distribution Counter',
                        data: [
                            parseInt("<%= data.studentStats.groupA %>") || 0,
                            parseInt("<%= data.studentStats.groupB %>") || 0,
                            parseInt("<%= data.studentStats.groupAB %>") || 0
                        ],
                        backgroundColor: ['rgba(91, 80, 255, 0.85)', 'rgba(40, 199, 111, 0.85)', 'rgba(255, 159, 67, 0.85)'],
                        borderRadius: 8,
                        borderWidth: 0
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: { y: { beginAtZero: true, grid: { color: '#f1f5f9' } }, x: { grid: { display: false } } }
                }
            });
        }

        // === 2. TAB TRANSITION ROUTER ===
        const tabs = document.querySelectorAll('.tab-btn');
        tabs.forEach(tab => {
            tab.addEventListener('click', () => {
                const targetFamily = tab.parentElement.getAttribute('data-tab-group');
                const targetPanelId = tab.getAttribute('data-tab-target');

                document.querySelectorAll(`[data-tab-group="${targetFamily}"] .tab-btn`).forEach(t => t.classList.remove('is-active'));
                document.querySelectorAll(`[data-tab-family="${targetFamily}"]`).forEach(p => p.classList.remove('is-active'));

                tab.classList.add('is-active');
                const targetPanel = document.querySelector(`[data-tab-panel="${targetPanelId}"]`);
                if (targetPanel) targetPanel.classList.add('is-active');
            });
        });

        // === 3. QUICK LIVE FILTER AND SEARCH CONTROLLER ===
        const searchInput = document.getElementById('studentSearchInput');
        if (searchInput) {
            searchInput.addEventListener('keyup', () => {
                const filterValue = searchInput.value.toLowerCase();
                const rows = document.querySelectorAll('#activeStudentsTable tbody tr');

                rows.forEach(row => {
                    const textMatch = row.textContent.toLowerCase().includes(filterValue);
                    row.style.display = textMatch ? '' : 'none';
                });
            });
        }

        // === 4. DRAWER INTERACTION LAYER AND FIELD MAPPER ===
        const detailTriggers = document.querySelectorAll('[data-detail-trigger]');
        const detailPanel = document.getElementById('studentDetailPanel');
        const backdrop = document.getElementById('sheetBackdrop');
        const closeDetailsBtn = document.getElementById('closeDetailsBtn');

        function closeMobileSheet() {
            if (detailPanel) detailPanel.classList.remove('is-open');
            if (backdrop) backdrop.classList.remove('is-visible');
        }

        if (detailPanel) {
            const emptyState = detailPanel.querySelector('.detail-panel__empty');
            const filledState = detailPanel.querySelector('.detail-panel__filled');

            detailTriggers.forEach(trigger => {
                trigger.addEventListener('click', () => {
                    if (emptyState) emptyState.style.style.setProperty('display', 'none', 'important');
                    if (filledState) filledState.style.display = 'block';

                    const dataMap = {
                        name: trigger.getAttribute('data-val-name'),
                        roll: trigger.getAttribute('data-val-roll'),
                        group: trigger.getAttribute('data-val-group'),
                        standard: trigger.getAttribute('data-val-standard'),
                        contact: trigger.getAttribute('data-val-contact'),
                        email: trigger.getAttribute('data-val-email'),
                        joining: trigger.getAttribute('data-val-joining'),
                        initials: trigger.getAttribute('data-val-initials')
                    };

                    Object.keys(dataMap).forEach(key => {
                        const field = detailPanel.querySelector(`[data-field="${key}"]`);
                        if (field) field.textContent = dataMap[key] || '—';
                    });

                    // Trigger Mobile Sliding Animations 
                    detailPanel.classList.add('is-open');
                    if (backdrop) backdrop.classList.add('is-visible');
                });
            });

            if (closeDetailsBtn) closeDetailsBtn.addEventListener('click', closeMobileSheet);
            if (backdrop) backdrop.addEventListener('click', closeMobileSheet);
        }

        // === 5. NEW: MOBILE SIDEBAR DRAWER CONTROLLER ===
        const menuBtn = document.querySelector('.topbar__menu-btn');
        const sidebar = document.querySelector('.sidebar');
        const sidebarOverlay = document.querySelector('.sidebar-overlay');
        const closeSidebarBtn = document.querySelector('.sidebar__close-btn'); // Add this to your sidebar if needed

        function openSidebar() {
            if (sidebar) sidebar.classList.add('is-open');
            if (sidebarOverlay) sidebarOverlay.classList.add('is-visible');
        }

        function closeSidebar() {
            if (sidebar) sidebar.classList.remove('is-open');
            if (sidebarOverlay) sidebarOverlay.classList.remove('is-visible');
        }

        if (menuBtn) {
            menuBtn.addEventListener('click', openSidebar);
        }

        if (sidebarOverlay) {
            sidebarOverlay.addEventListener('click', closeSidebar);
        }

        if (closeSidebarBtn) {
            closeSidebarBtn.addEventListener('click', closeSidebar);
        }
    });
</script>
