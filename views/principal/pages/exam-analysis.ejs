<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head', { title: 'Exam Analysis' }) %>
</head>
<body>
  <div class="app">
    <%- include('../partials/sidebar', { active: 'examAnalysis', data: data }) %>

    <div class="main">
      <%- include('../partials/topbar', { title: 'Exam Analysis', subtitle: 'Board · GUJCET · JEE · NEET — all metrics & exams', data: data }) %>

      <div class="content">

        <div class="kpi-grid">
          <div class="kpi-card">
            <div class="kpi-card__label">Total Exam</div>
            <div class="kpi-card__value num"><%= data.examStats.total %></div>
          </div>
          <div class="kpi-card is-success">
            <div class="kpi-card__label">Board Exam</div>
            <div class="kpi-card__value num"><%= data.examStats.board %></div>
          </div>
          <div class="kpi-card is-warning">
            <div class="kpi-card__label">Gujcet Exam</div>
            <div class="kpi-card__value num"><%= data.examStats.gujcet %></div>
          </div>
          <div class="kpi-card" style="position: relative;">
            <div class="kpi-card__label">Jee Exam</div>
            <div class="kpi-card__value num"><%= data.examStats.jee %></div>
          </div>
          <div class="kpi-card is-danger">
            <div class="kpi-card__label">Neet Exam</div>
            <div class="kpi-card__value num"><%= data.examStats.neet %></div>
          </div>
        </div>

        <% if (data.examStats.pending > 0) { %>
          <div class="banner banner-warning">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
              <line x1="12" y1="9" x2="12" y2="13"></line>
              <line x1="12" y1="17" x2="12.01" y2="17"></line>
            </svg>
            <div>
              <strong>Action Required:</strong> You have <%= data.examStats.pending %> exam records awaiting completion or grade uploads.
            </div>
          </div>
        <% } %>

        <div class="card" style="padding: 14px 20px; margin-bottom: 16px;">
          <div class="filters-wrapper">
            <div class="search-bar-container" style="flex: 1; min-width: 240px;">
              <input type="text" id="examSearchInput" class="field-input w-full" placeholder="🔍 Search exam ledger by subject name or ID...">
            </div>
            <div class="filters" style="margin-bottom: 0; gap: 12px;">
              <select id="filterExamSubject" class="filter-select">
                <option value="">All Subjects</option>
                <option value="Physics">Physics</option>
                <option value="Chemistry">Chemistry</option>
                <option value="Mathematics">Mathematics</option>
                <option value="Biology">Biology</option>
              </select>
              <select id="filterExamType" class="filter-select">
                <option value="">All Streams</option>
                <option value="Board">Board</option>
                <option value="GUJCET">GUJCET</option>
                <option value="JEE">JEE</option>
                <option value="NEET">NEET</option>
              </select>
            </div>
          </div>
        </div>

        <!-- Completed/Pending tables first (full-width) -->
        <div>
          <div class="tabs" id="examAnalysisTabs" style="margin-bottom: 12px;">
            <button class="tab-btn is-active" data-target="completed-exams">Complete Exam</button>
            <button class="tab-btn" data-target="pending-exams">Pending Exam</button>
          </div>

          <div class="tab-panel is-active" id="panel-completed-exams">
            <div class="card">
              <div class="card__head">
                <div>
                  <div class="card__title">Completed Exam</div>
                  <div class="card__desc">Historical performance records of completed examinations</div>
                </div>
              </div>
              <div class="table-wrap">
                <table>
                  <thead>
                    <tr>
                      <th>Exam No</th>
                      <th>Subject</th>
                      <th>Type</th>
                      <th>Average of Class</th>
                      <th>Action</th>
                    </tr>
                  </thead>
                  <tbody id="completedExamsBody">
                    <% data.exams.filter(e => e.status === 'completed').forEach(function(e){ %>
                      <tr class="exam-row" data-subject="<%= e.subject %>" data-type="<%= e.type %>">
                        <td class="num">#<%= e.examNo %></td>
                        <td style="font-weight: 600; color: var(--ink);"><%= e.subject %></td>
                        <td><span class="chip chip-neutral"><%= e.type %></span></td>
                        <td class="num" style="font-weight: 700; color: <%= e.classAverage >= 70 ? 'var(--success)' : 'var(--warning)' %>;">
                          <%= e.classAverage %>%
                        </td>
                        <td>
                          <% if (data.examAnalysisDetail[e.examNo]) { %>
                            <a href="/principal/exam-analysis/<%= e.examNo %>" class="btn btn-primary btn-sm">View Analysis</a>
                          <% } else { %>
                            <a href="/principal/exam-analysis/101" class="btn btn-ghost btn-sm">View Analysis</a>
                          <% } %>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>

          <div class="tab-panel" id="panel-pending-exams">
            <div class="card">
              <div class="card__head">
                <div>
                  <div class="card__title">Pending Exam</div>
                  <div class="card__desc">Exams complete but marks not entered by Assistant Faculty yet</div>
                </div>
              </div>
              <div class="table-wrap">
                <table>
                  <thead>
                    <tr>
                      <th>Exam No</th>
                      <th>Subject</th>
                      <th>Type</th>
                      <th>Average of Class</th>
                      <th>Action</th>
                    </tr>
                  </thead>
                  <tbody id="pendingExamsBody">
                    <% var pendingList = data.exams.filter(e => e.status !== 'completed'); %>
                    <% if (pendingList.length === 0) { %>
                      <tr>
                        <td colspan="5" class="text-slate" style="text-align: center; padding: 24px;">No evaluations currently pending.</td>
                      </tr>
                    <% } else { %>
                      <% pendingList.forEach(function(e){ %>
                        <tr class="exam-row" data-subject="<%= e.subject %>" data-type="<%= e.type %>">
                          <td class="num">#<%= e.examNo %></td>
                          <td style="font-weight: 600;"><%= e.subject %></td>
                          <td><span class="chip chip-neutral"><%= e.type %></span></td>
                          <td class="num">—</td>
                          <td><span class="text-slate" style="font-size:12.5px;">Awaiting marks</span></td>
                        </tr>
                      <% }) %>
                    <% } %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>

        <!-- Exams by Subject count below the table (from sketch 3) -->
        <div class="card" style="margin-top: 20px;">
          <div class="card__title" style="margin-bottom: 16px;">Exams count per Subject</div>
          <div class="progress-row">
            <div class="progress-row__label">Physics</div>
            <div class="progress-track"><div class="progress-fill" style="width: 75%; background: var(--indigo);"></div></div>
            <div class="progress-row__value num">25</div>
          </div>
          <div class="progress-row">
            <div class="progress-row__label">Chemistry</div>
            <div class="progress-track"><div class="progress-fill" style="width: 78%; background: var(--indigo);"></div></div>
            <div class="progress-row__value num">26</div>
          </div>
          <div class="progress-row">
            <div class="progress-row__label">Maths</div>
            <div class="progress-track"><div class="progress-fill" style="width: 39%; background: var(--indigo);"></div></div>
            <div class="progress-row__value num">13</div>
          </div>
          <div class="progress-row">
            <div class="progress-row__label">Biology</div>
            <div class="progress-track"><div class="progress-fill" style="width: 36%; background: var(--indigo);"></div></div>
            <div class="progress-row__value num">12</div>
          </div>
        </div>

      </div>
    </div>
  </div>

  <%- include('../partials/scripts') %>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      // 1. NAVIGATION TAB WORKFLOWS
      const tabButtons = document.querySelectorAll('#examAnalysisTabs .tab-btn');
      const tabPanels = document.querySelectorAll('.tab-panel');

      tabButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          tabButtons.forEach(b => b.classList.remove('is-active'));
          tabPanels.forEach(p => p.classList.remove('is-active'));

          btn.classList.add('is-active');
          const targetPanel = document.getElementById(`panel-${btn.getAttribute('data-target')}`);
          if (targetPanel) targetPanel.classList.add('is-active');
        });
      });

      // 2. RUNTIME TABLE FILTER MATRIX LOGIC
      const searchInput = document.getElementById('examSearchInput');
      const subjectSelect = document.getElementById('filterExamSubject');
      const typeSelect = document.getElementById('filterExamType');
      
      function runFilterEngine() {
        const query = searchInput.value.toLowerCase().trim();
        const selSub = subjectSelect.value;
        const selType = typeSelect.value;
        const targetRows = document.querySelectorAll('.exam-row');

        targetRows.forEach(row => {
          const rowSubject = row.getAttribute('data-subject');
          const rowType = row.getAttribute('data-type');
          const searchableText = row.innerText.toLowerCase();

          const matchSearch = !query || searchableText.includes(query);
          const matchSubject = !selSub || rowSubject === selSub;
          const matchType = !selType || rowType === selType;

          if (matchSearch && matchSubject && matchType) {
            row.style.display = '';
          } else {
            row.style.display = 'none';
          }
        });
      }

      if (searchInput) searchInput.addEventListener('input', runFilterEngine);
      if (subjectSelect) subjectSelect.addEventListener('change', runFilterEngine);
      if (typeSelect) typeSelect.addEventListener('change', runFilterEngine);
    });
  </script>
</body>
</html>
