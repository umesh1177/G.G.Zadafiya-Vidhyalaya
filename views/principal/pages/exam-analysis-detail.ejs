<!DOCTYPE html>
<html lang="en">

<head>
  <%- include('../partials/head', { title: 'Exam Analysis Detail' }) %>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>

<body>
  <div class="app">
    <%- include('../partials/sidebar', { active: 'examAnalysis' , data: data }) %>

    <div class="main">
      <%- include('../partials/topbar', { title: 'Exam Analysis — ' + exam.subject + ' (Exam #' + exam.examNo + ')' ,
        subtitle: exam.type + ' Stream · Conducted ' + exam.date , data: data }) %>

        <div class="content">
          <a href="/principal/exam-analysis" class="btn btn-ghost btn-sm" style="margin-bottom:18px;">&larr; Back to Exam Analysis</a>

          <div class="kpi-grid">
            <div class="kpi-card">
              <div class="kpi-card__label">Class Average</div>
              <div class="kpi-card__value num"><%= exam.performance.overallAverage %>%</div>
            </div>
            <div class="kpi-card is-success">
              <div class="kpi-card__label">Pass Students</div>
              <div class="kpi-card__value num"><%= exam.performance.passStudents %></div>
            </div>
            <div class="kpi-card is-danger">
              <div class="kpi-card__label">Failed Students</div>
              <div class="kpi-card__value num"><%= exam.performance.failedStudents %></div>
            </div>
            <% if (exam.type !== 'Board') { %>
              <div class="kpi-card is-warning">
                <div class="kpi-card__label">Stream Type</div>
                <div class="kpi-card__value" style="font-size: 20px; font-weight: 700; margin-top: 10px;"><%= exam.type %></div>
              </div>
            <% } %>
          </div>

          <div class="tabs" id="examDetailTabs" style="margin-bottom: 20px;">
            <button class="tab-btn is-active" data-target="performance">Performance</button>
            <button class="tab-btn" data-target="leaderboard">Leaderboard</button>
            <button class="tab-btn" data-target="student-analysis">Student Analysis</button>
          </div>

          <!-- PERFORMANCE TAB -->
          <div class="tab-panel is-active" id="panel-performance">
            <div class="grid-2" style="margin-bottom: 20px;">
              <div class="card chart-card">
                <div class="card__title" style="margin-bottom:14px;">Score Bracket Distribution</div>
                <div class="chart-container" style="height: 240px; position: relative;">
                  <canvas id="scoreBracketChart"></canvas>
                </div>
              </div>

              <div class="card chart-card">
                <div class="card__title" style="margin-bottom:14px;">Exam Average Comparison</div>
                <div class="chart-container" style="height: 240px; position: relative;">
                  <canvas id="examComparisonChart"></canvas>
                </div>
              </div>
            </div>

            <div class="grid-list-2" style="margin-bottom: 20px;">
              <div class="card">
                <div class="card__title" style="margin-bottom: 14px;">Performance Indicators</div>
                <div class="detail-panel__row">
                  <span>Growth Rate %</span>
                  <span class="text-success num" style="font-weight: 700;">+6.0%</span>
                </div>
                <div class="detail-panel__row">
                  <span>Downfall Rate %</span>
                  <span class="text-slate num">—</span>
                </div>
                <div class="detail-panel__row">
                  <span>No. of student marks increase</span>
                  <span class="text-success num" style="font-weight: 700;"><%= exam.performance.growthChart.increase %></span>
                </div>
                <div class="detail-panel__row">
                  <span>No. of student marks decrease</span>
                  <span class="text-danger num" style="font-weight: 700;"><%= exam.performance.growthChart.decrease %></span>
                </div>
              </div>

              <div class="card" style="display: flex; flex-direction: column; justify-content: center;">
                <div class="card__title" style="margin-bottom: 10px;">Performance Message</div>
                <div class="banner banner-success" style="margin-bottom: 0; font-size: 14px; line-height: 1.6; padding: 18px;">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 8px; flex-shrink: 0;">
                    <circle cx="12" cy="12" r="10"></circle>
                    <path d="M12 16v-4"></path>
                    <path d="M12 8h.01"></path>
                  </svg>
                  <div>
                    <%= exam.performance.message %>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- LEADERBOARD TAB -->
          <div class="tab-panel" id="panel-leaderboard">
            <div class="card">
              <div class="card__head">
                <div>
                  <div class="card__title">Exam Leaderboard</div>
                  <div class="card__desc">Top performing students in this examination evaluation cycle</div>
                </div>
              </div>
              <div class="table-wrap">
                <table>
                  <thead>
                    <tr>
                      <th>Rank</th>
                      <th>Roll No</th>
                      <th>Name</th>
                      <th>Marks</th>
                      <th>Percentile</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% exam.leaderboard.forEach(function(l){ %>
                      <tr>
                        <td class="num font-bold">#<%= l.rank %></td>
                        <td class="num"><%= l.rollNo %></td>
                        <td style="font-weight: 600; color: var(--ink);"><%= l.name %></td>
                        <td class="num" style="font-weight: 700;"><%= l.marks %></td>
                        <td class="num text-success"><%= l.percentile %>%</td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>

          <!-- STUDENT ANALYSIS TAB -->
          <div class="tab-panel" id="panel-student-analysis">
            <div class="grid-2" style="margin-bottom: 20px; grid-template-columns: 1fr 1fr;">
              <!-- Left: Top Growth & Consistent Growth -->
              <div style="display: flex; flex-direction: column; gap: 20px;">
                <div class="card" style="margin-bottom: 0;">
                  <div class="card__title" style="margin-bottom: 12px;">Top Growth Student List 📈</div>
                  <div class="table-wrap">
                    <table>
                      <thead><tr><th>Roll No</th><th>Name</th><th>Growth Rate</th></tr></thead>
                      <tbody>
                        <% exam.studentAnalysis.topGrowth.forEach(function(s){ %>
                          <tr><td class="num"><%= s.rollNo %></td><td style="font-weight: 600;"><%= s.name %></td><td class="num text-success">+<%= s.rate %>%</td></tr>
                        <% }) %>
                      </tbody>
                    </table>
                  </div>
                </div>

                <div class="card" style="margin-bottom: 0;">
                  <div class="card__title" style="margin-bottom: 12px;">Consistent Growth Student List</div>
                  <div class="table-wrap">
                    <table>
                      <thead><tr><th>Roll No</th><th>Name</th></tr></thead>
                      <tbody>
                        <% exam.studentAnalysis.consistentGrowth.forEach(function(s){ %>
                          <tr><td class="num"><%= s.rollNo %></td><td style="font-weight: 600;"><%= s.name %></td></tr>
                        <% }) %>
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>

              <!-- Right: Decrease Growth & Consistent Decrease -->
              <div style="display: flex; flex-direction: column; gap: 20px;">
                <div class="card" style="margin-bottom: 0;">
                  <div class="card__title" style="margin-bottom: 12px;">Decrease Growth Student List 📉</div>
                  <div class="table-wrap">
                    <table>
                      <thead><tr><th>Roll No</th><th>Name</th><th>Decrease Rate</th></tr></thead>
                      <tbody>
                        <% exam.studentAnalysis.decreaseGrowth.forEach(function(s){ %>
                          <tr><td class="num"><%= s.rollNo %></td><td style="font-weight: 600;"><%= s.name %></td><td class="num text-danger">-<%= s.rate %>%</td></tr>
                        <% }) %>
                      </tbody>
                    </table>
                  </div>
                </div>

                <div class="card" style="margin-bottom: 0;">
                  <div class="card__title" style="margin-bottom: 12px;">Consistent Decrease Growth Student List</div>
                  <div class="table-wrap">
                    <table>
                      <thead><tr><th>Roll No</th><th>Name</th></tr></thead>
                      <tbody>
                        <% exam.studentAnalysis.consistentDecrease.forEach(function(s){ %>
                          <tr><td class="num"><%= s.rollNo %></td><td style="font-weight: 600;"><%= s.name %></td></tr>
                        <% }) %>
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>
            </div>

            <!-- Subject-wise weak and strong graphs -->
            <div class="grid-2" style="margin-bottom: 20px; grid-template-columns: 1fr 1fr;">
              <div class="card chart-card">
                <div class="card__title" style="margin-bottom: 14px;">% Weak Students by Subject</div>
                <div class="chart-container" style="height: 240px; position: relative;">
                  <canvas id="weakStudentsChart"></canvas>
                </div>
              </div>

              <div class="card chart-card">
                <div class="card__title" style="margin-bottom: 14px;">% Strong Students by Subject</div>
                <div class="chart-container" style="height: 240px; position: relative;">
                  <canvas id="strongStudentsChart"></canvas>
                </div>
              </div>
            </div>
          </div>

        </div>
    </div>
  </div>

  <%- include('../partials/scripts') %>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      // 1. TABS SWAPPING
      const tabButtons = document.querySelectorAll('#examDetailTabs .tab-btn');
      const tabPanels = document.querySelectorAll('.tab-panel');

      tabButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          tabButtons.forEach(b => b.classList.remove('is-active'));
          tabPanels.forEach(p => p.classList.remove('is-active'));

          btn.classList.add('is-active');
          const targetPanel = document.getElementById(`panel-${btn.getAttribute('data-target')}`);
          if (targetPanel) targetPanel.classList.add('is-active');
        });
      });

      // 2. CHART RENDERING
      const examData = <%- JSON.stringify(exam) %>;

      // SCORE BRACKETS PIE CHART
      const bracketsCtx = document.getElementById('scoreBracketChart');
      if (bracketsCtx) {
        const bracketLabels = examData.performance.scoreBrackets.map(b => b.range);
        const bracketCounts = examData.performance.scoreBrackets.map(b => b.count);
        new Chart(bracketsCtx, {
          type: 'doughnut',
          data: {
            labels: bracketLabels,
            datasets: [{
              data: bracketCounts,
              backgroundColor: ['#1F9D6B', '#3B4FE0', '#F59E0B', '#EF4444', '#6B7290'],
              borderWidth: 0
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              legend: {
                position: 'right',
                labels: { font: { family: 'Manrope', weight: 600 } }
              }
            }
          }
        });
      }

      // COMPARISON BAR CHART
      const comparisonCtx = document.getElementById('examComparisonChart');
      if (comparisonCtx) {
        new Chart(comparisonCtx, {
          type: 'bar',
          data: {
            labels: ['Previous Exam', 'Current Exam'],
            datasets: [{
              label: 'Class Average %',
              data: [72, examData.performance.overallAverage],
              backgroundColor: ['#98A0BC', '#3B4FE0'],
              borderRadius: 6,
              maxBarThickness: 45
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
              y: { min: 0, max: 100 }
            }
          }
        });
      }

      // WEAK STUDENTS BAR CHART
      const weakCtx = document.getElementById('weakStudentsChart');
      if (weakCtx) {
        new Chart(weakCtx, {
          type: 'bar',
          data: {
            labels: examData.studentAnalysis.subjectWise.labels,
            datasets: [{
              data: examData.studentAnalysis.subjectWise.weak,
              backgroundColor: '#EF4444',
              borderRadius: 6,
              maxBarThickness: 45
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
              y: { min: 0, max: 30 }
            }
          }
        });
      }

      // STRONG STUDENTS BAR CHART
      const strongCtx = document.getElementById('strongStudentsChart');
      if (strongCtx) {
        new Chart(strongCtx, {
          type: 'bar',
          data: {
            labels: examData.studentAnalysis.subjectWise.labels,
            datasets: [{
              data: examData.studentAnalysis.subjectWise.strong,
              backgroundColor: '#1F9D6B',
              borderRadius: 6,
              maxBarThickness: 45
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
              y: { min: 0, max: 30 }
            }
          }
        });
      }
    });
  </script>
</body>

</html>
