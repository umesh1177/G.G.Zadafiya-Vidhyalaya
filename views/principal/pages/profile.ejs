<!DOCTYPE html>
<html lang="en">

<head>
  <%- include('../partials/head', { title: 'Principal Profile' }) %>
</head>

<body>
  <div class="app">
    <%- include('../partials/sidebar', { active: 'profile' , data: data }) %>

    <div class="main">
      <%- include('../partials/topbar', { title: 'Principal Profile' ,
        subtitle: 'Manage account configuration parameters and institution settings' , data: data }) %>

        <div class="content">
          <div class="grid-2">
            <!-- Left: Profile Details & Update Form -->
            <div class="card">
              <div class="card__head">
                <div>
                  <div class="card__title">Personal Profile Details</div>
                  <div class="card__desc">Review and update your system administrator metadata</div>
                </div>
              </div>
              <form class="form-grid" onsubmit="alert('Principal profile configurations updated successfully.'); return false;" style="margin-top: 14px;">
                <div>
                  <label class="field-label">Full Name</label>
                  <input class="field-input w-full" type="text" value="<%= data.principal.name %>" required>
                </div>
                <div>
                  <label class="field-label">Designation / Role</label>
                  <input class="field-input w-full" type="text" value="Principal" readonly style="background: var(--surface-muted); cursor: not-allowed;">
                </div>
                <div>
                  <label class="field-label">Email Address</label>
                  <input class="field-input w-full" type="email" value="<%= data.principal.email %>" required>
                </div>
                <div>
                  <label class="field-label">Contact Number</label>
                  <input class="field-input w-full" type="text" value="<%= data.principal.contactNo %>" required>
                </div>
                <div>
                  <label class="field-label">Login Username</label>
                  <input class="field-input w-full" type="text" value="<%= data.principal.username %>" readonly style="background: var(--surface-muted); cursor: not-allowed;">
                </div>
                <div>
                  <label class="field-label">Login Password</label>
                  <input class="field-input w-full" type="password" value="••••••••••••" placeholder="Enter new password to change">
                </div>
                <div class="span-2" style="margin-top: 10px;">
                  <button class="btn btn-primary btn-block" type="submit">Save Profile Changes</button>
                </div>
              </form>
            </div>

            <!-- Right: Institution Details & Avatar Preview -->
            <div style="display: flex; flex-direction: column; gap: 20px;">
              <!-- Profile Avatar Card -->
              <div class="card" style="text-align: center; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 28px;">
                <div class="topbar__avatar dynamic-avatar" style="width: 80px; height: 80px; font-size: 28px; margin-bottom: 14px; font-weight: 700; background: var(--indigo-softer); color: var(--indigo);">
                  <%= data.principal.initials %>
                </div>
                <div style="font-size: 18px; font-weight: 700; color: var(--ink);"><%= data.principal.name %></div>
                <div class="text-slate" style="font-size: 13px; margin-top: 4px;">SVVS Administrator Profile</div>
              </div>

              <!-- Institution Details Card -->
              <div class="card">
                <div class="card__head" style="margin-bottom: 12px;">
                  <div>
                    <div class="card__title">Institution Configurations</div>
                    <div class="card__desc">System wide default school profile metadata</div>
                  </div>
                </div>
                <div class="detail-panel__row">
                  <span>School Name</span>
                  <span style="font-weight: 600;"><%= data.principal.school %></span>
                </div>
                <div class="detail-panel__row">
                  <span>Affiliated Board</span>
                  <span style="font-weight: 600;">GSEB (Gujarat Secondary and Higher Secondary Education Board)</span>
                </div>
                <div class="detail-panel__row">
                  <span>Science Stream Control</span>
                  <span style="font-weight: 600;">Standard 11 &amp; 12</span>
                </div>
                <div class="detail-panel__row">
                  <span>Office Room Location</span>
                  <span style="font-weight: 600;">Room A-102 (Admin Wing)</span>
                </div>
              </div>
            </div>
          </div>
        </div>
    </div>
  </div>

  <%- include('../partials/scripts') %>
</body>

</html>

