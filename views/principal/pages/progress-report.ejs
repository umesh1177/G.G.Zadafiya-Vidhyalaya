<!DOCTYPE html>
<html lang="en">

<head>
  <%- include('../partials/head', { title: 'Progress Report' }) %>
  <style>
    /* Styling adjustments for grid elements and charts */
    .section-title {
      font-size: 15px;
      font-weight: 700;
      color: var(--indigo);
      margin-bottom: 12px;
      padding-bottom: 6px;
      border-bottom: 2px solid var(--indigo-soft);
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .grid-wrap-4 {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 16px;
      margin-bottom: 18px;
    }
    .chart-container-sm {
      height: 180px;
      position: relative;
      width: 100%;
      overflow: hidden;
    }
    .kpi-row {
      display: flex;
      flex-direction: column;
      gap: 8px;
      justify-content: center;
    }
    .kpi-item {
      padding: 10px 14px;
      background: var(--surface-muted);
      border-radius: var(--radius-sm);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .kpi-item span:first-child {
      font-size: 12px;
      font-weight: 600;
      color: var(--slate);
    }
    .kpi-item span:last-child {
      font-size: 14px;
      font-weight: 700;
    }

    /* Equal-width two column grid for tables */
    .grid-equal-2 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
    }

    /* Force all grid tracks and cards to allow shrinking below min-content size */
    .grid-2, .grid-3, .grid-equal-2, .grid-wrap-4, .grid-2 > *, .grid-3 > *, .grid-equal-2 > *, .grid-wrap-4 > *, .card {
      min-width: 0 !important;
    }
    .table-wrap {
      width: 100% !important;
      overflow-x: auto !important;
      -webkit-overflow-scrolling: touch;
    }

    /* Absolute responsiveness rules for mobile and tablet screens */
    @media (max-width: 1024px) {
      .grid-wrap-4 {
        grid-template-columns: repeat(2, 1fr) !important;
      }
    }
    @media (max-width: 768px) {
      .grid-wrap-4 {
        grid-template-columns: 1fr !important;
      }
      .grid-2, .grid-equal-2, .grid-3, .grid-list-2 {
        grid-template-columns: 1fr !important;
      }
      .filters-wrapper {
        flex-direction: column;
        align-items: stretch !important;
        gap: 14px !important;
      }
      .filters {
        flex-direction: column;
        align-items: stretch !important;
        width: 100%;
      }
      .filter-select {
        width: 100% !important;
      }
      .btn {
        width: 100%;
        text-align: center;
      }
      /* Ensure flex layouts under parent filters wrap nicely */
      .filters-wrapper > div {
        flex-direction: column;
        align-items: stretch !important;
        width: 100%;
      }
    }
  </style></head>

<body>
  <div class="app">
    <%- include('../partials/sidebar', { active: 'progressReport' , data: data }) %>

    <div class="main">
      <%- include('../partials/topbar', { title: 'Progress Report' ,
        subtitle: 'Comprehensive school progress metrics with integrated learning analytics' , data: data }) %>

        <div class="content">

          <!-- TOP FILTERS BAR (Sketch 3 / Photo 1) -->
          <div class="card" style="padding: 14px 20px; margin-bottom: 20px;">
            <div class="filters-wrapper" style="display: flex; justify-content: space-between; align-items: center; width: 100%; flex-wrap: wrap; gap: 16px;">
              <div style="display: flex; align-items: center; gap: 16px; flex-wrap: wrap;">
                <div style="font-weight: 700; color: var(--indigo); font-size: 14px;">Progress Filter</div>
                <div class="filters" style="margin-bottom: 0; gap: 12px;">
                  <select class="filter-select" id="reportStandardFilter">
                    <option value="11">Standard 11</option>
                    <option value="12" selected>Standard 12</option>
                  </select>
                  <select class="filter-select" id="reportDivisionFilter">
                    <option value="A" selected>Division A</option>
                    <option value="B">Division B</option>
                  </select>
                  <select class="filter-select" id="reportWeekFilter">
                    <option value="1">Week 1</option>
                    <option value="2">Week 2</option>
                    <option value="3">Week 3</option>
                    <option value="4" selected>Week 4 (Current)</option>
                  </select>
                </div>
              </div>
              <button class="btn btn-primary" onclick="alert('Progress Report published successfully and notifications broadcasted to parents.')">Publish Progress Report</button>
            </div>
          </div>

          <!-- TABS HEADERS (Photo 1) -->
          <div class="tabs" id="progressTabs" style="margin-bottom: 20px;">
            <button class="tab-btn is-active" data-target="weekly">Weekly</button>
            <button class="tab-btn" data-target="monthly">Monthly</button>
            <button class="tab-btn" data-target="advance">Advance</button>
          </div>

          <!-- ------------------ WEEKLY REPORT TAB ------------------ -->
          <div class="tab-panel is-active" id="panel-weekly">
            
            <!-- Performance message -->
            <div class="card" style="margin-bottom: 20px;">
              <div class="card__title" style="font-size: 13.5px; margin-bottom: 10px;">Performance Message</div>
              <div class="banner banner-success" style="margin-bottom: 0;">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
                <span><%= data.progressReport.weekly.message %></span>
              </div>
            </div>
            
            <!-- SECTION 1: ACADEMIC PERFORMANCE & COMPARISON -->
            <div class="section-title">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/></svg>
              Section 1: Academic Performance & Comparison
            </div>
            
            <div class="grid-wrap-4">
              <!-- Subject averages -->
              <div class="card chart-card">
                <div class="card__title" style="font-size:12.5px; margin-bottom:10px;">Subject-wise Average</div>
                <div class="chart-container-sm"><canvas id="weeklySubjectChart"></canvas></div>
              </div>
              <!-- Exam type averages -->
              <div class="card chart-card">
                <div class="card__title" style="font-size:12.5px; margin-bottom:10px;">Exam-wise Average</div>
                <div class="chart-container-sm"><canvas id="weeklyExamChart"></canvas></div>
              </div>
              <!-- Score brackets pie chart -->
              <div class="card chart-card">
                <div class="card__title" style="font-size:12.5px; margin-bottom:10px;">Score Brackets Distribution</div>
                <div class="chart-container-sm"><canvas id="weeklyPieChart"></canvas></div>
              </div>
              <!-- Comparison graph with growth/downfall -->
              <div class="card">
                <div class="card__title" style="font-size:12.5px; margin-bottom:10px;">Average (Previous vs Current)</div>
                <div class="grid-2" style="gap: 10px; grid-template-columns: 1.2fr .8fr;">
                  <div class="chart-container-sm" style="height: 140px;"><canvas id="weeklyCompareChart"></canvas></div>
                  <div class="kpi-row">
                    <div class="kpi-item"><span>Growth</span><span class="text-success">+<%= data.progressReport.weekly.growthVsLastWeek %>%</span></div>
                    <div class="kpi-item"><span>Downfall</span><span class="text-danger">—</span></div>
                  </div>
                </div>
              </div>
            </div>

            <!-- SECTION 2: STUDENT STANDINGS -->
            <div class="section-title">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
              Section 2: Student Standings & Movers
            </div>
            
            <div class="grid-equal-2" style="margin-bottom: 20px;">
              <!-- Top 3 Students list -->
              <div class="card">
                <div class="card__head" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                  <div>
                    <div class="card__title" style="font-size: 13.5px;">Top 3 Student list</div>
                  </div>
                  <div class="flex gap-8">
                    <select class="filter-select select-sm" style="font-size: 11px; padding: 2px 6px; min-width: 60px;">
                      <option>Board</option><option>JEE</option><option>NEET</option>
                    </select>
                    <select class="filter-select select-sm" style="font-size: 11px; padding: 2px 6px; min-width: 60px;">
                      <option>Phy</option><option>Chem</option><option>Maths</option>
                    </select>
                  </div>
                </div>
                <div class="table-wrap">
                  <table>
                    <thead>
                      <tr><th>Roll No</th><th>Name</th><th>Subject</th><th>Score</th></tr>
                    </thead>
                    <tbody>
                      <% data.progressReport.weekly.top3.forEach(function(s){ %>
                        <tr>
                          <td class="num"><%= s.rollNo %></td>
                          <td style="font-weight: 600;"><%= s.name %></td>
                          <td><%= s.subject %></td>
                          <td class="num font-bold text-success"><%= s.score %></td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              </div>

              <!-- Bottom 3 Students list -->
              <div class="card">
                <div class="card__head" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                  <div>
                    <div class="card__title" style="font-size: 13.5px;">Bottom 3 Student list</div>
                  </div>
                  <div class="flex gap-8">
                    <select class="filter-select select-sm" style="font-size: 11px; padding: 2px 6px; min-width: 60px;">
                      <option>Overall</option><option>Week</option>
                    </select>
                    <select class="filter-select select-sm" style="font-size: 11px; padding: 2px 6px; min-width: 60px;">
                      <option>Phy</option><option>Chem</option><option>Maths</option>
                    </select>
                  </div>
                </div>
                <div class="table-wrap">
                  <table>
                    <thead>
                      <tr><th>Roll No</th><th>Name</th><th>Score</th></tr>
                    </thead>
                    <tbody>
                      <% data.progressReport.weekly.bottom3.forEach(function(s){ %>
                        <tr>
                          <td class="num"><%= s.rollNo %></td>
                          <td style="font-weight: 600;"><%= s.name %></td>
                          <td class="num font-bold text-danger"><%= s.score %></td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>

            <div class="grid-equal-2" style="margin-bottom: 20px;">
              <!-- Growth student list table -->
              <div class="card">
                <div class="card__title" style="font-size:13.5px; margin-bottom:10px;">Growth student list table</div>
                <div class="table-wrap">
                  <table>
                    <thead><tr><th>Roll No</th><th>Name</th><th>Growth Rate</th></tr></thead>
                    <tbody>
                      <% data.progressReport.weekly.growth.forEach(function(s){ %>
                        <tr>
                          <td class="num"><%= s.rollNo %></td>
                          <td style="font-weight: 600;"><%= s.name %></td>
                          <td class="num text-success"><%= s.growth %></td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              </div>

              <!-- Downfall student list table -->
              <div class="card">
                <div class="card__title" style="font-size:13.5px; margin-bottom:10px;">Downfall student list table</div>
                <div class="table-wrap">
                  <table>
                    <thead><tr><th>Roll No</th><th>Name</th><th>Downfall Rate</th></tr></thead>
                    <tbody>
                      <% data.progressReport.weekly.downfall.forEach(function(s){ %>
                        <tr>
                          <td class="num"><%= s.rollNo %></td>
                          <td style="font-weight: 600;"><%= s.name %></td>
                          <td class="num text-danger"><%= s.downfall %></td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>

            <!-- SECTION 3: LEARNING ASSESSMENT (LT) ANALYSIS -->
            <div class="section-title">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/><path d="m9 12 2 2 4-4"/></svg>
              Section 3: Learning Assessment (LT) Analysis
            </div>

            <div class="grid-2" style="margin-bottom: 20px;">
              <!-- LT comparison chart -->
              <div class="card">
                <div class="card__title" style="font-size:13px; margin-bottom: 12px;">LT Average (Previous vs Current Week)</div>
                <div class="chart-container-sm" style="height: 180px;"><canvas id="weeklyLtCompareChart"></canvas></div>
              </div>
              
              <!-- Subject range sliders -->
              <div class="card">
                <div class="card__head" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                  <div class="card__title" style="font-size:13px;">Subject Ranges Count</div>
                  <select class="filter-select select-sm" style="font-size: 11px; padding: 2px 6px;">
                    <option>Physics</option><option>Chemistry</option><option>Maths</option>
                  </select>
                </div>
                <div>
                  <% data.progressReport.weekly.ltAnalysis.subjectRanges.forEach(function(r){ %>
                    <div class="progress-row">
                      <div class="progress-row__label"><%= r.label %></div>
                      <div class="progress-track"><div class="progress-fill" style="width: <%= (r.val / 25) * 100 %>%; background: var(--indigo);"></div></div>
                      <div class="progress-row__value num"><%= r.val %> students</div>
                    </div>
                  <% }) %>
                </div>
              </div>
            </div>

            <div class="grid-equal-2" style="margin-bottom: 20px;">
              <!-- Good performer student list table -->
              <div class="card">
                <div class="card__title" style="font-size: 13.5px; margin-bottom: 10px;">Good Performer Student list TABLE</div>
                <div class="table-wrap">
                  <table>
                    <thead><tr><th>Roll No</th><th>Name</th><th>Action</th></tr></thead>
                    <tbody>
                      <% data.progressReport.weekly.ltAnalysis.goodPerformers.forEach(function(s){ %>
                        <tr>
                          <td class="num"><%= s.rollNo %></td>
                          <td style="font-weight: 600;"><%= s.name %></td>
                          <td>
                            <button class="btn btn-ghost btn-sm" data-modal-open="goodPerformerScoreModal"
                              data-name="<%= s.name %>" data-excellent="<%= s.excellent %>"
                              data-better="<%= s.better %>" data-good="<%= s.good %>">
                              View Score
                            </button>
                          </td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              </div>

              <!-- Bad performer student list table -->
              <div class="card">
                <div class="card__title" style="font-size: 13.5px; margin-bottom: 10px;">Bad Performer Student list TABLE</div>
                <div class="table-wrap">
                  <table>
                    <thead><tr><th>Roll No</th><th>Name</th><th>Action</th></tr></thead>
                    <tbody>
                      <% data.progressReport.weekly.ltAnalysis.badPerformers.forEach(function(s){ %>
                        <tr>
                          <td class="num"><%= s.rollNo %></td>
                          <td style="font-weight: 600;"><%= s.name %></td>
                          <td>
                            <button class="btn btn-ghost btn-sm" data-modal-open="goodPerformerScoreModal"
                              data-name="<%= s.name %>" data-excellent="<%= s.excellent %>"
                              data-better="<%= s.better %>" data-good="<%= s.good %>">
                              View Score
                            </button>
                          </td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>

            <!-- Weak LT Topic List Card -->
            <div class="card" style="margin-bottom: 20px;">
              <div class="card__title" style="font-size: 13.5px; margin-bottom: 10px;">Weak LT Topic List</div>
              <div class="table-wrap">
                <table>
                  <thead><tr><th>Sr No</th><th>Topic Name</th><th>Average</th></tr></thead>
                  <tbody>
                    <% data.progressReport.weekly.ltAnalysis.weakTopics.forEach(function(t){ %>
                      <tr>
                        <td class="num"><%= t.srNo %></td>
                        <td style="font-weight: 600;"><%= t.topicName %></td>
                        <td><span class="chip chip-warning"><%= t.classAverage %></span></td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            </div>

            <!-- SECTION 4: SYLLABUS PROGRESS & DISCIPLINE -->
            <div class="section-title">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
              Section 4: Syllabus & Discipline
            </div>

            <div class="grid-2" style="margin-bottom: 20px;">
              <!-- Syllabus complete & Topics finished -->
              <div class="card" style="display: flex; flex-direction: column; gap: 20px;">
                <div>
                  <div class="card__title" style="font-size: 13px; margin-bottom: 12px;">Syllabus complete in this week</div>
                  <% data.progressReport.weekly.syllabusComplete.forEach(function(s){ %>
                    <div class="progress-row">
                      <div class="progress-row__label"><%= s.subject %></div>
                      <div class="progress-track"><div class="progress-fill" style="width: <%= s.val * 3 %>%; background: var(--indigo);"></div></div>
                      <div class="progress-row__value num"><%= s.val %>%</div>
                    </div>
                  <% }) %>
                </div>

                <div style="border-top:1px solid var(--line-soft); padding-top: 14px;">
                  <div class="card__title" style="font-size: 13px; margin-bottom: 12px;">No of topics finish by faculty in this week</div>
                  <% data.progressReport.weekly.facultyTopics.forEach(function(f){ %>
                    <div class="progress-row">
                      <div class="progress-row__label"><%= f.name %></div>
                      <div class="progress-track"><div class="progress-fill" style="width: <%= (f.topics / 30) * 100 %>%; background: var(--success);"></div></div>
                      <div class="progress-row__value num"><%= f.topics %> topics</div>
                    </div>
                  <% }) %>
                </div>
              </div>

              <!-- Undisciplined student list -->
              <div class="card">
                <div class="card__title" style="font-size: 13.5px; margin-bottom: 12px;">undiscipline student list</div>
                <div class="table-wrap">
                  <table>
                    <thead><tr><th>Roll No</th><th>Name</th><th>Type</th><th>Action</th></tr></thead>
                    <tbody>
                      <% data.discipline.undisciplined.forEach(function(u){ %>
                        <tr>
                          <td class="num"><%= u.rollNo %></td>
                          <td style="font-weight: 600;"><%= u.name %></td>
                          <td><span class="chip chip-danger"><%= u.type %></span></td>
                          <td>
                            <button class="btn btn-ghost btn-sm" data-modal-open="undisciplineReportModal"
                              data-name="<%= u.name %>" data-roll="<%= u.rollNo %>"
                              data-type="<%= u.type %>" data-date="<%= u.date %>"
                              data-notedby="<%= u.notedBy %>" data-description="<%= u.description %>">
                              View Details
                            </button>
                          </td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>



          </div>

          <!-- ------------------ MONTHLY REPORT TAB ------------------ -->
          <div class="tab-panel" id="panel-monthly">
            
            <!-- Performance message -->
            <div class="card" style="margin-bottom: 20px;">
              <div class="card__title" style="font-size: 13.5px; margin-bottom: 10px;">Performance Message</div>
              <div class="banner banner-success" style="margin-bottom: 0;">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
                <span><%= data.progressReport.monthly.message %></span>
              </div>
            </div>
            
            <!-- SECTION 1: ACADEMIC PERFORMANCE -->
            <div class="section-title">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/></svg>
              Section 1: Academic Performance & Comparison (Monthly)
            </div>
            
            <div class="grid-wrap-4">
              <div class="card chart-card">
                <div class="card__title" style="font-size:12.5px; margin-bottom:10px;">Subject-wise Average</div>
                <div class="chart-container-sm"><canvas id="monthlySubjectChart"></canvas></div>
              </div>
              <div class="card chart-card">
                <div class="card__title" style="font-size:12.5px; margin-bottom:10px;">Exam-wise Average</div>
                <div class="chart-container-sm"><canvas id="monthlyExamChart"></canvas></div>
              </div>
              <div class="card chart-card">
                <div class="card__title" style="font-size:12.5px; margin-bottom:10px;">Score Brackets Distribution</div>
                <div class="chart-container-sm"><canvas id="monthlyPieChart"></canvas></div>
              </div>
              <div class="card">
                <div class="card__title" style="font-size:12.5px; margin-bottom:10px;">Average (Previous vs Current)</div>
                <div class="grid-2" style="gap: 10px; grid-template-columns: 1.2fr .8fr;">
                  <div class="chart-container-sm" style="height: 140px;"><canvas id="monthlyCompareChart"></canvas></div>
                  <div class="kpi-row">
                    <div class="kpi-item"><span>Growth</span><span class="text-success">+<%= data.progressReport.monthly.momGrowth %>%</span></div>
                    <div class="kpi-item"><span>Downfall</span><span class="text-danger">—</span></div>
                  </div>
                </div>
              </div>
            </div>

            <!-- SECTION 2: STUDENT STANDINGS -->
            <div class="section-title">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
              Section 2: Student Standings & Movers (Monthly)
            </div>
            
            <div class="grid-equal-2" style="margin-bottom: 20px;">
              <div class="card">
                <div class="card__head" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                  <div class="card__title" style="font-size: 13.5px;">Top 3 Student list</div>
                  <div class="flex gap-8">
                    <select class="filter-select select-sm" style="font-size: 11px; padding: 2px 6px; min-width: 60px;"><option>Board</option></select>
                    <select class="filter-select select-sm" style="font-size: 11px; padding: 2px 6px; min-width: 60px;"><option>Phy</option></select>
                  </div>
                </div>
                <div class="table-wrap">
                  <table>
                    <thead><tr><th>Roll No</th><th>Name</th><th>Subject</th><th>Score</th></tr></thead>
                    <tbody>
                      <% data.progressReport.monthly.top3.forEach(function(s){ %>
                        <tr>
                          <td class="num"><%= s.rollNo %></td>
                          <td style="font-weight: 600;"><%= s.name %></td>
                          <td><%= s.subject %></td>
                          <td class="num font-bold text-success"><%= s.score %></td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              </div>

              <div class="card">
