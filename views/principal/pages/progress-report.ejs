  <div class="modal-overlay" id="goodPerformerScoreModal" data-modal>
    <div class="modal-box" style="background: #fff; padding: 24px; border-radius: var(--radius-lg); max-width: 450px; width: 100%; position: relative;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
        <div class="card__title" style="font-weight: 700; font-size: 15px; margin: 0;"><span id="perfModalName">Student</span>'s LT Score Distribution</div>
        <button class="modal-close" data-modal-close="goodPerformerScoreModal" style="background: transparent; border: none; cursor: pointer; font-size: 24px; line-height: 1; color: var(--slate);">&times;</button>
      </div>
      <div class="detail-panel__filled">
        <div class="detail-panel__row"><span>Excellent Ratings</span><span id="perfModalExcellent" class="text-success">—</span></div>
        <div class="detail-panel__row"><span>Better Ratings</span><span id="perfModalBetter" class="text-warning">—</span></div>
        <div class="detail-panel__row"><span>Good Ratings</span><span id="perfModalGood" class="text-slate">—</span></div>
      </div>
    </div>
  </div>

  <!-- UNDISCIPLINE DETAIL MODAL -->
  <div class="modal-overlay" id="undisciplineReportModal" data-modal>
    <div class="modal-box" style="background: #fff; padding: 24px; border-radius: var(--radius-lg); max-width: 500px; width: 100%; position: relative;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
        <div class="card__title" style="font-weight: 700; font-size: 16px; margin: 0;">Discipline Remark Detail</div>
        <button class="modal-close" data-modal-close="undisciplineReportModal" style="background: transparent; border: none; cursor: pointer; font-size: 24px; line-height: 1; color: var(--slate);">&times;</button>
      </div>
      <div class="detail-panel__filled">
        <div class="detail-panel__row"><span>Roll No</span><span id="undModRoll">—</span></div>
        <div class="detail-panel__row"><span>Name</span><span id="undModName">—</span></div>
        <div class="detail-panel__row"><span>Incident Date</span><span id="undModDate">—</span></div>
        <div class="detail-panel__row"><span>Remark Type</span><span id="undModType">—</span></div>
        <div class="detail-panel__row"><span>Noted By</span><span id="undModNotedby">—</span></div>
        <div style="margin-top:10px; padding-top:10px; border-top:1px solid var(--line); margin-bottom: 16px;">
          <div class="text-slate" style="font-size:11.5px; font-weight:700; margin-bottom:6px;">DESCRIPTION</div>
          <div style="font-size:13px;" id="undModDescription">—</div>
        </div>
        <div class="detail-panel__actions">
          <button class="btn btn-primary btn-sm btn-block" onclick="alert('Message successfully routed to parents.')">Notify Parent</button>
        </div>
      </div>
    </div>
  </div>

  <%- include('../partials/scripts') %>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      // 1. TABS NAVIGATION ENGINE
      const tabButtons = document.querySelectorAll('#progressTabs .tab-btn');
      const tabPanels = document.querySelectorAll('.tab-panel');

      tabButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          tabButtons.forEach(b => b.classList.remove('is-active'));
          tabPanels.forEach(p => p.classList.remove('is-active'));

          btn.classList.add('is-active');
          const targetPanel = document.getElementById(`panel-${btn.getAttribute('data-target')}`);
          if (targetPanel) targetPanel.classList.add('is-active');
        });
      });

      // 2. MODALS POPULATOR
      const undModal = document.getElementById('undisciplineReportModal');
      if (undModal) {
        const triggers = document.querySelectorAll('[data-modal-open="undisciplineReportModal"]');
        triggers.forEach(btn => {
          btn.addEventListener('click', () => {
            undModal.querySelector('#undModRoll').textContent = btn.getAttribute('data-roll') || '—';
            undModal.querySelector('#undModName').textContent = btn.getAttribute('data-name') || '—';
            undModal.querySelector('#undModDate').textContent = btn.getAttribute('data-date') || '—';
            undModal.querySelector('#undModType').textContent = btn.getAttribute('data-type') || '—';
            undModal.querySelector('#undModNotedby').textContent = btn.getAttribute('data-notedby') || '—';
            undModal.querySelector('#undModDescription').textContent = btn.getAttribute('data-description') || '—';
          });
        });
      }

      const scoreModal = document.getElementById('goodPerformerScoreModal');
      if (scoreModal) {
        const scoreTriggers = document.querySelectorAll('[data-modal-open="goodPerformerScoreModal"]');
        scoreTriggers.forEach(btn => {
          btn.addEventListener('click', () => {
            scoreModal.querySelector('#perfModalName').textContent = btn.getAttribute('data-name') || 'Student';
            scoreModal.querySelector('#perfModalExcellent').textContent = btn.getAttribute('data-excellent') || '—';
            scoreModal.querySelector('#perfModalBetter').textContent = btn.getAttribute('data-better') || '—';
            scoreModal.querySelector('#perfModalGood').textContent = btn.getAttribute('data-good') || '—';
          });
        });
      }

      // === CHART RENDERINGS ===
      const progressData = <%- JSON.stringify(data.progressReport) %>;

      // Helper to build bar chart
      function createBarChart(canvasId, labels, dataVals, colorHex) {
        const ctx = document.getElementById(canvasId);
        if (!ctx) return;
        new Chart(ctx, {
          type: 'bar',
          data: {
            labels: labels,
            datasets: [{
              data: dataVals,
              backgroundColor: colorHex,
              borderRadius: 4,
              maxBarThickness: 32
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: { y: { min: 0, max: 100 } }
          }
        });
      }

      // Helper to build double bar chart (Previous vs Current)
      function createCompareChart(canvasId, dataArr, colorPrev, colorCurr) {
        const ctx = document.getElementById(canvasId);
        if (!ctx) return;
        new Chart(ctx, {
          type: 'bar',
          data: {
            labels: dataArr.map(d => d.period),
            datasets: [{
              data: dataArr.map(d => d.avg),
              backgroundColor: [colorPrev, colorCurr],
              borderRadius: 4,
              maxBarThickness: 32
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: { y: { min: 0, max: 100 } }
          }
        });
      }

      // Helper to build pie chart
      function createPieChart(canvasId, labels, dataVals) {
        const ctx = document.getElementById(canvasId);
        if (!ctx) return;
        new Chart(ctx, {
          type: 'pie',
          data: {
            labels: labels,
            datasets: [{
              data: dataVals,
              backgroundColor: ['#1F9D6B', '#3B4FE0', '#F59E0B'],
              borderWidth: 0
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { position: 'right' } }
          }
        });
      }

      // --- WEEKLY CHARTS ---
      createBarChart('weeklySubjectChart', progressData.weekly.subjectAverages.map(s => s.subject), progressData.weekly.subjectAverages.map(s => s.avg), '#3B4FE0');
      createBarChart('weeklyExamChart', progressData.weekly.examAverages.map(e => e.type), progressData.weekly.examAverages.map(e => e.avg), '#1F9D6B');
      createPieChart('weeklyPieChart', progressData.weekly.scoreBrackets.map(b => b.range), progressData.weekly.scoreBrackets.map(b => b.count));
      createCompareChart('weeklyCompareChart', progressData.weekly.prevVsCurr, '#64748B', '#3B4FE0');
      createCompareChart('weeklyLtCompareChart', progressData.weekly.ltAnalysis.prevVsCurr, '#64748B', '#3B4FE0');

      // --- MONTHLY CHARTS ---
      createBarChart('monthlySubjectChart', progressData.monthly.subjectAverages.map(s => s.subject), progressData.monthly.subjectAverages.map(s => s.avg), '#3B4FE0');
      createBarChart('monthlyExamChart', progressData.monthly.examAverages.map(e => e.type), progressData.monthly.examAverages.map(e => e.avg), '#1F9D6B');
      createPieChart('monthlyPieChart', progressData.monthly.scoreBrackets.map(b => b.range), progressData.monthly.scoreBrackets.map(b => b.count));
      createCompareChart('monthlyCompareChart', progressData.monthly.prevVsCurr, '#64748B', '#3B4FE0');
      createCompareChart('monthlyLtCompareChart', progressData.monthly.ltAnalysis.prevVsCurr, '#64748B', '#3B4FE0');

      // --- ADVANCE CHARTS ---
      createBarChart('advanceSubjectChart', progressData.advance.subjectAverages.map(s => s.subject), progressData.advance.subjectAverages.map(s => s.avg), '#3B4FE0');
      createBarChart('advanceExamChart', progressData.advance.examAverages.map(e => e.type), progressData.advance.examAverages.map(e => e.avg), '#1F9D6B');
      createPieChart('advancePieChart', progressData.advance.scoreBrackets.map(b => b.range), progressData.advance.scoreBrackets.map(b => b.count));
      createCompareChart('advanceCompareChart', progressData.advance.prevVsCurr, '#64748B', '#3B4FE0');
      createCompareChart('advanceLtCompareChart', progressData.advance.ltAnalysis.prevVsCurr, '#64748B', '#3B4FE0');
    });
  </script>
</body>

</html>
