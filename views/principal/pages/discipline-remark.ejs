<!DOCTYPE html>
<html lang="en">

<head>
  <%- include('../partials/head', { title: 'Discipline Remark' }) %>
</head>

<body>
  <div class="app">
    <%- include('../partials/sidebar', { active: 'discipline' , data: data }) %>

      <div class="main">
        <%- include('../partials/topbar', { title: 'Discipline Remark' ,
          subtitle: 'Structured records, with direct parent notification' , data: data }) %>

          <div class="content">

              <div class="card">
                <div class="card__head">
                  <div>
                    <div class="card__title">Undisciplined Students</div>
                    <div class="card__desc">Recently noted incidents</div>
                  </div>
                </div>
                <div class="filters">
                  <select class="filter-select">
                    <option>Day</option>
                  </select>
                  <select class="filter-select">
                    <option>Type</option>
                    <option>Long hair</option>
                    <option>Long nail</option>
                    <option>Late to school</option>
                  </select>
                  <select class="filter-select">
                    <option>Standard</option>
                    <option>11</option>
                    <option>12</option>
                  </select>
                  <select class="filter-select">
                    <option>Noted By</option>
                  </select>
                </div>
                <div class="table-wrap">
                  <table>
                    <thead>
                      <tr>
                        <th>Roll No</th>
                        <th>Name</th>
                        <th>Date</th>
                        <th>Standard</th>
                        <th>Action</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% if (data && data.discipline && data.discipline.undisciplined) { %>
                        <% data.discipline.undisciplined.forEach(function(d){ %>
                          <tr>
                            <td class="num">
                              <%= d.rollNo %>
                            </td>
                            <td>
                              <%= d.name %>
                            </td>
                            <td class="num">
                              <%= d.date %>
                            </td>
                            <td class="num">
                              <%= d.standard %>
                            </td>
                            <td>
                              <button class="btn btn-ghost btn-sm" data-modal-open="disciplineDetailModal"
                                data-val-name="<%= d.name %>" data-val-roll="<%= d.rollNo %>"
                                data-val-date="<%= d.date %>" data-val-standard="<%= d.standard %>"
                                data-val-type="<%= d.type %>" data-val-notedby="<%= d.notedBy %>"
                                data-val-description="<%= d.description %>">View</button>
                            </td>
                          </tr>
                          <% }) %>
                            <% } %>
                    </tbody>
                  </table>
                </div>
              </div>

            <div class="card">
              <div class="card__head">
                <div>
                  <div class="card__title">Frequently Undisciplined Students</div>
                  <div class="card__desc">Students with repeated incidents — flagged for early intervention</div>
                </div>
              </div>
              <div class="table-wrap">
                <table>
                  <thead>
                    <tr>
                      <th>Roll No</th>
                      <th>Name</th>
                      <th>Standard</th>
                      <th>No. of Incidents</th>
                      <th>Action</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% if (data && data.discipline && data.discipline.frequentOffenders) { %>
                      <% data.discipline.frequentOffenders.forEach(function(f, idx){ %>
                        <tr>
                          <td class="num">
                            <%= f.rollNo %>
                          </td>
                          <td>
                            <%= f.name %>
                          </td>
                          <td class="num">
                            <%= f.standard %>
                          </td>
                          <td><span class="chip chip-danger num">
                              <%= f.count %>
                            </span></td>
                          <td><button class="btn btn-ghost btn-sm" data-modal-open="historyModal<%= idx %>">View
                              History</button></td>
                        </tr>
                        <% }) %>
                          <% } %>
                  </tbody>
                </table>
              </div>
            </div>

          </div>
      </div>
  </div>

  <% if (data && data.discipline && data.discipline.frequentOffenders) { %>
    <% data.discipline.frequentOffenders.forEach(function(f, idx){ %>
      <div class="modal-overlay" id="historyModal<%= idx %>" data-modal
        style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 999; align-items: center; justify-content: center;">
        <div class="modal-box"
          style="background: #fff; padding: 20px; border-radius: 8px; max-width: 600px; width: 100%; margin: auto;">
          <div class="modal-box__head"
            style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px;">
            <div>
              <div class="card__title" style="font-weight: 700;">
                <%= f.name %> — Discipline History
              </div>
              <div class="card__desc" style="font-size: 12px; color: var(--text-muted, #64748b);">Roll No <%= f.rollNo
                  %> · Standard <%= f.standard %>
              </div>
            </div>
            <button class="modal-close" data-modal-close="historyModal<%= idx %>"
              style="background: transparent; border: none; cursor: pointer;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                stroke-linejoin="round" style="width: 20px; height: 20px;">
                <path d="M6 6l12 12M18 6 6 18" />
              </svg>
            </button>
          </div>
          <div class="table-wrap">
            <table style="width: 100%;">
              <thead>
                <tr>
                  <th style="text-align: left;">Type</th>
                  <th style="text-align: left;">Date</th>
                  <th style="text-align: left;">Noted By</th>
                </tr>
              </thead>
              <tbody>
                <% f.history.forEach(function(h){ %>
                  <tr>
                    <td><span class="chip chip-warning">
                        <%= h.type %>
                      </span></td>
                    <td class="num">
                      <%= h.date %>
                    </td>
                    <td>
                      <%= h.notedBy %>
                    </td>
                  </tr>
                  <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
      <% }) %>
        <% } %>

          <!-- DISCIPLINE INCIDENT DETAIL MODAL -->
  <div class="modal-overlay" id="disciplineDetailModal" data-modal style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 999; align-items: center; justify-content: center;">
    <div class="modal-box" style="background: #fff; padding: 24px; border-radius: var(--radius-lg); max-width: 500px; width: 100%; position: relative;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
        <div class="card__title" style="font-weight: 700; font-size: 16px; margin: 0;">Discipline Record Detail</div>
        <button class="modal-close" data-modal-close="disciplineDetailModal" style="background: transparent; border: none; cursor: pointer; font-size: 24px; line-height: 1; color: var(--slate);">&times;</button>
      </div>
      <div class="detail-panel__filled" id="disciplineModalFilledState">
        <div class="detail-panel__row"><span>Roll No</span><span id="discModRoll">—</span></div>
        <div class="detail-panel__row"><span>Name</span><span id="discModName">—</span></div>
        <div class="detail-panel__row"><span>Date</span><span id="discModDate">—</span></div>
        <div class="detail-panel__row"><span>Standard</span><span id="discModStandard">—</span></div>
        <div class="detail-panel__row"><span>Type</span><span id="discModType">—</span></div>
        <div class="detail-panel__row"><span>Noted By</span><span id="discModNotedby">—</span></div>
        <div style="margin-top:10px; padding-top:10px; border-top:1px solid var(--line); margin-bottom: 16px;">
          <div class="text-slate" style="font-size:11.5px; font-weight:700; margin-bottom:6px;">DESCRIPTION</div>
          <div style="font-size:13px;" id="discModDescription">—</div>
        </div>
        <div class="detail-panel__actions">
          <button class="btn btn-primary btn-sm btn-block" onclick="alert('Notification alert successfully queued for routing to destination household contacts.')">Send Message to Parent</button>
        </div>
      </div>
    </div>
  </div>

  <%- include('../partials/scripts') %>

    <script>
      document.addEventListener('DOMContentLoaded', () => {

        // 1. Record Detail Modal Populator Logic
        const detailTriggers = document.querySelectorAll('[data-modal-open="disciplineDetailModal"]');
        const discModal = document.getElementById('disciplineDetailModal');
        if (discModal) {
          detailTriggers.forEach(btn => {
            btn.addEventListener('click', () => {
              discModal.querySelector('#discModRoll').textContent = btn.getAttribute('data-val-roll') || '—';
              discModal.querySelector('#discModName').textContent = btn.getAttribute('data-val-name') || '—';
              discModal.querySelector('#discModDate').textContent = btn.getAttribute('data-val-date') || '—';
              discModal.querySelector('#discModStandard').textContent = btn.getAttribute('data-val-standard') || '—';
              discModal.querySelector('#discModType').textContent = btn.getAttribute('data-val-type') || '—';
              discModal.querySelector('#discModNotedby').textContent = btn.getAttribute('data-val-notedby') || '—';
              discModal.querySelector('#discModDescription').textContent = btn.getAttribute('data-val-description') || '—';
            });
          });
        }

                // 2. Modals Control Actions Layer
                const openTriggers = document.querySelectorAll('[data-modal-open]');
                openTriggers.forEach(trigger => {
                  trigger.addEventListener('click', () => {
                    const targetId = trigger.getAttribute('data-modal-open');
                    const targetModal = document.getElementById(targetId);
                    if (targetModal) {
                      targetModal.style.display = 'flex';
                    }
                  });
                });

                const closeTriggers = document.querySelectorAll('[data-modal-close], .modal-overlay');
                closeTriggers.forEach(closer => {
                  closer.addEventListener('click', (e) => {
                    // If clicking overlay container backdrop or button directly, trigger termination
                    if (closer.hasAttribute('data-modal-close') || e.target === closer) {
                      const targetModal = closer.closest('[data-modal]');
                      if (targetModal) {
                        targetModal.style.display = 'none';
                      }
                    }
                  });
                });
              });
            </script>
</body>

</html>
